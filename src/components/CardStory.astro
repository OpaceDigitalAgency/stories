---
import type { CardStoryProps } from '../types/components';
import TagBadge from './TagBadge.astro';
import RatingStars from './RatingStars.astro';

const { story, className = '' } = Astro.props as CardStoryProps;

// Default cover image with source type indicator
let defaultCoverImage = '/images/default-cover.svg';
// We'll use the same default image for all source types for now
// In production, you would create specific default images for each source type
const defaultAvatarImage = '/images/default-avatar.svg';

// Handle cover image - use the appropriate size for cards
let coverImageUrl = defaultCoverImage;
if (story?.cover_urls) {
  // If we have cover_urls object with sizes
  coverImageUrl = story.cover_urls.small || story.cover_urls.thumbnail || story.cover_urls.default;
} else if (story?.coverImage) {
  if (typeof story.coverImage === 'object' && (story.coverImage.small || story.coverImage.thumbnail)) {
    // If coverImage is an object with sizes
    coverImageUrl = story.coverImage.small || story.coverImage.thumbnail || story.coverImage.default;
  } else if (typeof story.coverImage === 'string') {
    // Backward compatibility with old API responses
    coverImageUrl = story.coverImage;
  }
}
console.log("Cover image URL:", coverImageUrl); // Debug log

// Handle author avatar - directly use the URL from the API
let authorAvatarUrl = defaultAvatarImage;
if (story?.author?.avatar && typeof story.author.avatar === 'string') {
  authorAvatarUrl = story.author.avatar;
}
console.log("Author avatar URL:", authorAvatarUrl); // Debug log

// Format date if available
const formattedDate = story.publishDate 
  ? new Date(story.publishDate).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric'
    })
  : null;
---

<article class={`card-story bg-white rounded-xl overflow-hidden shadow-md hover:shadow-lg transition-all duration-300 transform-style-3d hover:translate-z-4 flex flex-col h-full ${className}`}>
  <a href={`/stories/${story.slug}`} class="block relative">
    <div class="relative h-48 overflow-hidden">
      <img
        src={coverImageUrl}
        alt={story.title}
        class="w-full h-full object-cover transition-transform duration-700 hover:scale-110"
        onerror="this.onerror=null; this.src='/images/default-cover.svg';"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-70"></div>
      
      {/* Source type indicator */}
      {story.source_type && (
        <div class="absolute top-2 right-2 bg-black/50 text-white text-xs px-2 py-1 rounded-full backdrop-blur-sm">
          {story.source_type}
        </div>
      )}
      
      {story.tags && story.tags.length > 0 && (
        <div class="absolute bottom-4 left-4 flex flex-wrap gap-2">
          {story.tags.slice(0, 2).map(tag => (
            <TagBadge tag={tag} size="sm" />
          ))}
          {story.tags.length > 2 && (
            <span class="text-xs text-white bg-black/30 backdrop-blur-sm px-2 py-1 rounded-full">
              +{story.tags.length - 2}
            </span>
          )}
        </div>
      )}
    </div>
  </a>
  
  <div class="p-5 flex flex-col flex-grow">
    {/* Title */}
    <h3 class="text-lg font-bold text-text-primary line-clamp-2 hover:text-primary transition-colors duration-300 mb-1">
      <a href={`/stories/${story.slug}`}>
        {story.title}
      </a>
    </h3>
    
    {/* Ratings - only show for non-child stories with allow_reviews=true */}
    {story.rating && typeof story.rating === 'number' && story.rating > 0 &&
     story.source_type !== 'child' && story.allow_reviews === true && (
      <div class="mb-3">
        <RatingStars
          rating={story.rating}
          size="sm"
          allow_reviews={true}
          source_type={story.source_type}
        />
      </div>
    )}
    
    {/* Excerpt */}
    <div class="min-h-[4.5rem] mb-4">
      {story.excerpt && (
        <p class="text-sm text-text-secondary line-clamp-3">
          {story.excerpt}
        </p>
      )}
    </div>
    
    {/* Author and date */}
    <div class="flex items-center justify-between mt-auto pt-3 border-t border-neutral-100">
      {story.author && (
        <a href={`/authors/${story.author.slug}`} class="flex items-center group">
          <div class="w-8 h-8 rounded-full overflow-hidden mr-2 border-2 border-white shadow-sm">
            <img
              src={authorAvatarUrl}
              alt={story.author.name}
              class="w-full h-full object-cover"
              onerror="this.onerror=null; this.src='/images/default-avatar.svg';"
            />
          </div>
          <span class="text-xs text-text-secondary group-hover:text-primary transition-colors duration-300">
            {story.author.name}
          </span>
        </a>
      )}
      
      {formattedDate && (
        <span class="text-xs text-text-secondary/70">
          {formattedDate}
        </span>
      )}
    </div>
  </div>
</article>
