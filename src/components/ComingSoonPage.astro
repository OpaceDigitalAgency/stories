---
// ComingSoonPage Component
// A reusable component for displaying a "Coming Soon" page for features that are in development

interface Props {
  title: string;
  description?: string;
  featureName: string;
  estimatedRelease?: string;
  signupEnabled?: boolean;
  image?: string;
  ctaText?: string;
  ctaLink?: string;
  fullWidth?: boolean;
}

const {
  title = "Coming Soon",
  description = "We're working hard to bring you this exciting new feature. Stay tuned for updates!",
  featureName,
  estimatedRelease,
  signupEnabled = true,
  image = "https://api.storiesfromtheweb.org/uploads/optimized/68128956b67985-46295508-premium-reading-large.jpg",
  ctaText = "Back to Home",
  ctaLink = "/",
  fullWidth = false
} = Astro.props;
---

<div class="min-h-[70vh] flex flex-col items-center justify-center py-16 px-4 relative overflow-hidden">
  <!-- Decorative blobs -->
  <div class="absolute -top-32 -right-32 w-[32rem] h-[32rem] bg-primary-200/30 rounded-full blur-3xl animate-blob"></div>
  <div class="absolute -bottom-32 -left-32 w-[32rem] h-[32rem] bg-secondary-200/30 rounded-full blur-3xl animate-blob animation-delay-2000"></div>
  <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[32rem] h-[32rem] bg-accent-200/20 rounded-full blur-3xl animate-blob animation-delay-4000"></div>

  <div class={`container ${fullWidth ? 'max-w-full' : 'max-w-4xl'} mx-auto relative z-10`}>
    <div class="bg-white rounded-2xl overflow-hidden shadow-xl transform-style-3d hover:translate-z-4 transition-all duration-500">
      <!-- Header with image -->
      <div class="relative h-64 md:h-80 overflow-hidden">
        <img
          src={image}
          alt={`${featureName} Coming Soon`}
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/50 to-transparent"></div>

        <!-- Coming Soon Badge -->
        <div class="absolute top-4 right-4">
          <div class="bg-gradient-to-r from-purple-600 to-blue-500 text-white px-6 py-3 rounded-xl font-bold text-lg shadow-xl backdrop-blur-sm transform scale-110 animate-pulse-slow">
            <span class="flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-2 animate-bounce-gentle">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" />
              </svg>
              Coming Soon
            </span>
          </div>
        </div>

        <!-- Title overlay -->
        <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
          <h1 class="text-3xl md:text-4xl font-display font-bold text-white mb-2">{title}</h1>
          {estimatedRelease && (
            <p class="text-white/80 text-lg">
              <span class="font-semibold">Estimated Release:</span> {estimatedRelease}
            </p>
          )}
        </div>
      </div>

      <!-- Content -->
      <div class="p-6 md:p-8">
        <div class="prose prose-lg max-w-none">
          <p class="text-lg text-text-secondary mb-6">{description}</p>

          <h2 class="text-2xl font-display font-bold text-text-primary mb-4">What to Expect</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
            <div class="bg-neutral-50 p-5 rounded-xl shadow-sm">
              <div class="flex items-center mb-3">
                <div class="bg-primary/10 p-2 rounded-full mr-3">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-primary">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
                  </svg>
                </div>
                <h3 class="text-xl font-bold text-text-primary">Exclusive Content</h3>
              </div>
              <p class="text-text-secondary">Access premium stories and content not available to regular users.</p>
            </div>

            <div class="bg-neutral-50 p-5 rounded-xl shadow-sm">
              <div class="flex items-center mb-3">
                <div class="bg-secondary/10 p-2 rounded-full mr-3">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-secondary">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                  </svg>
                </div>
                <h3 class="text-xl font-bold text-text-primary">Personalized Experience</h3>
              </div>
              <p class="text-text-secondary">Get recommendations tailored to your reading preferences.</p>
            </div>

            <div class="bg-neutral-50 p-5 rounded-xl shadow-sm">
              <div class="flex items-center mb-3">
                <div class="bg-accent/10 p-2 rounded-full mr-3">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-accent">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                  </svg>
                </div>
                <h3 class="text-xl font-bold text-text-primary">Ad-Free Reading</h3>
              </div>
              <p class="text-text-secondary">Enjoy an uninterrupted reading experience without advertisements.</p>
            </div>

            <div class="bg-neutral-50 p-5 rounded-xl shadow-sm">
              <div class="flex items-center mb-3">
                <div class="bg-tertiary/10 p-2 rounded-full mr-3">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-tertiary">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 01-2.448-2.448 14.9 14.9 0 01.06-.312m-2.24 2.39a4.493 4.493 0 00-1.757 4.306 4.493 4.493 0 004.306-1.758M16.5 9a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z" />
                  </svg>
                </div>
                <h3 class="text-xl font-bold text-text-primary">Advanced Features</h3>
              </div>
              <p class="text-text-secondary">Access to premium tools and features to enhance your experience.</p>
            </div>
          </div>

          {signupEnabled && (
            <div class="bg-gradient-to-r from-primary-50 to-accent-50 p-6 rounded-xl shadow-md mb-8">
              <h3 class="text-xl font-bold text-text-primary mb-3">Get Notified When We Launch</h3>
              <p class="text-text-secondary mb-4">Sign up to be the first to know when {featureName} is available.</p>

              <form id="notifyForm" class="flex flex-col sm:flex-row gap-3">
                <input
                  type="email"
                  name="email"
                  id="subscriber-email"
                  placeholder="Your email address"
                  class="flex-grow px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
                  required
                />
                <input type="hidden" name="feature" value={featureName.toLowerCase()} />
                <button
                  type="submit"
                  id="notify-submit-btn"
                  class="bg-primary text-white px-6 py-3 rounded-lg font-bold hover:bg-primary-600 transition-colors duration-300 whitespace-nowrap"
                >
                  Notify Me
                </button>
              </form>

              <div id="notification-result" class="mt-3 p-4 rounded-lg hidden">
                <div id="success-message" class="text-success-500 font-semibold bg-success-50 p-3 rounded-lg border border-success-200 hidden"></div>
                <div id="error-message" class="text-danger-500 font-semibold bg-danger-50 p-3 rounded-lg border border-danger-200 hidden"></div>
              </div>

              <script>
                // Form submission handler
                document.addEventListener('DOMContentLoaded', function() {
                  const form = document.getElementById('notifyForm') as HTMLFormElement;
                  const resultDiv = document.getElementById('notification-result');
                  const successMsg = document.getElementById('success-message');
                  const errorMsg = document.getElementById('error-message');
                  const submitBtn = document.getElementById('notify-submit-btn') as HTMLButtonElement;

                  if (form && resultDiv && successMsg && errorMsg && submitBtn) {
                    form.addEventListener('submit', async function(e) {
                      e.preventDefault();

                      // Show loading state
                      submitBtn.disabled = true;
                      submitBtn.innerHTML = 'Submitting...';

                      // Get form data
                      const formData = new FormData(form);
                      const formObject: Record<string, string> = {};
                      formData.forEach((value, key) => {
                        if (typeof value === 'string') {
                          formObject[key] = value;
                        }
                      });

                      try {
                        console.log('Submitting subscription data:', formObject);

                        // Submit to API
                        const response = await fetch('https://api.storiesfromtheweb.org/api/v1/subscribers.php', {
                          method: 'POST',
                          headers: {
                            'Content-Type': 'application/json'
                          },
                          body: JSON.stringify(formObject)
                        });

                        console.log('API response status:', response.status);
                        const data = await response.json();
                        console.log('API response data:', data);

                        // Reset form
                        form.reset();

                        // Show success message
                        resultDiv.classList.remove('hidden');
                        successMsg.classList.remove('hidden');
                        errorMsg.classList.add('hidden');
                        successMsg.textContent = data.message || 'Thank you for subscribing! We\'ll notify you when this feature is available.';

                      } catch (error) {
                        console.error('Subscription error details:', error);

                        // Show error message
                        resultDiv.classList.remove('hidden');
                        errorMsg.classList.remove('hidden');
                        successMsg.classList.add('hidden');
                        errorMsg.textContent = 'Sorry, there was an error submitting your request. Please try again.';
                      } finally {
                        // Reset button state
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = 'Notify Me';
                      }
                    });
                  }
                });
              </script>
            </div>
          )}

          <div class="flex justify-center">
            <a
              href={ctaLink}
              class="inline-flex items-center bg-white text-primary border-2 border-primary hover:bg-primary hover:text-white px-6 py-3 rounded-full font-bold text-lg shadow-sm hover:shadow-md transition-all duration-300"
            >
              <span class="flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3" />
                </svg>
                {ctaText}
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Blob animation */
  @keyframes blob {
    0% {
      transform: translate(0px, 0px) scale(1);
    }
    33% {
      transform: translate(30px, -50px) scale(1.1);
    }
    66% {
      transform: translate(-20px, 20px) scale(0.9);
    }
    100% {
      transform: translate(0px, 0px) scale(1);
    }
  }

  .animate-blob {
    animation: blob 7s infinite;
  }

  .animation-delay-2000 {
    animation-delay: 2s;
  }

  .animation-delay-4000 {
    animation-delay: 4s;
  }
</style>
