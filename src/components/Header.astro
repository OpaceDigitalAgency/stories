---
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

// Skip breadcrumbs for homepage
if (currentPath === '/') {
  return;
}

interface Crumb {
  text: string;
  href?: string;
}

// Generate breadcrumbs based on current path
function generateBreadcrumbs(path: string): Crumb[] {
  const parts = path.split('/').filter(Boolean);
  const crumbs: Crumb[] = [{ text: 'Home', href: '/' }];
  
  for (let i = 0; i < parts.length; i++) {
    const href = `/${parts.slice(0, i + 1).join('/')}`;
    const text = parts[i]
      .split('-')
      .map(word => word.charAt(0).toUpperCase() + word.slice(1))
      .join(' ');
    
    if (i === parts.length - 1) {
      crumbs.push({ text });
    } else {
      crumbs.push({ text, href });
    }
  }
  
  return crumbs;
}

const crumbs = generateBreadcrumbs(currentPath);
---

{currentPath !== '/' && (
  <div class="bg-white/50 backdrop-blur-sm border-b">
    <div class="container mx-auto px-4 py-4">
      <Breadcrumbs crumbs={crumbs} />
    </div>
  </div>
)}