---
// Props for customization
interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
  bgClass?: string;
  feature?: string;
}

// Default values
const {
  title = "Stay Updated",
  description = "Subscribe to our newsletter to receive new stories, author spotlights, and creative writing tips.",
  buttonText = "Subscribe",
  bgClass = "bg-gradient-to-br from-primary-50 to-primary-100",
  feature = "newsletter"
} = Astro.props;
---

<section class="py-16 relative z-20">
  <div class="container mx-auto px-4">
    <div class={`max-w-4xl mx-auto ${bgClass} rounded-3xl p-12 shadow-xl text-center relative z-30`}>
      <h2 class="text-3xl font-display font-bold text-text-primary mb-4">{title}</h2>
      <p class="text-text-secondary text-lg mb-8">
        {description}
      </p>

      <form
        id="global-newsletter-form"
        class="max-w-2xl mx-auto relative z-40"
        action="https://api.storiesfromtheweb.org/public/save-subscriber.php"
        method="POST"
      >
        <div class="flex flex-col sm:flex-row gap-3">
          <input
            type="email"
            name="email"
            id="global-newsletter-email"
            placeholder="Your email address"
            class="flex-grow px-4 py-3 rounded-xl border-2 border-neutral-dark focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-300"
            required
          />
          <input type="hidden" name="feature" value={feature} />
          <button
            type="submit"
            id="global-newsletter-submit"
            class="inline-block bg-primary text-white font-bold px-6 py-3 rounded-xl shadow-playful hover:shadow-xl hover:bg-primary-600 transition-all duration-300 cursor-pointer active:scale-95 active:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 relative z-50"
          >
            <span class="flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 mr-2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
              </svg>
              {buttonText}
            </span>
          </button>
        </div>
        <p class="text-sm text-gray-500 mt-3">
          We respect your privacy. Unsubscribe at any time.
        </p>
        <!-- Success message (hidden by default) -->
        <div id="global-newsletter-success" class="hidden mt-4 p-3 bg-green-100 text-green-700 rounded-lg text-center">
          Thank you for subscribing! We'll keep you updated with the latest news and resources.
        </div>
        <!-- Error message (hidden by default) -->
        <div id="global-newsletter-error" class="hidden mt-4 p-3 bg-red-100 text-red-700 rounded-lg text-center">
          There was an error processing your subscription. Please try again.
        </div>
      </form>
    </div>
  </div>
</section>

<script is:inline>
  console.log('NewsletterSignup component script loaded');
  // Newsletter form submission
  document.addEventListener('DOMContentLoaded', function() {
    console.log('Newsletter form script loaded');
    const newsletterForm = document.getElementById('global-newsletter-form');
    console.log('Newsletter form found:', !!newsletterForm);

    // Log that we found the submit button
    const submitButton = document.getElementById('global-newsletter-submit');
    if (submitButton) {
      console.log('Submit button found');
    }

    if (newsletterForm) {
      newsletterForm.addEventListener('submit', function(e) {
        console.log('Form submitted');
        e.preventDefault();

        // Get form data
        const emailInput = document.getElementById('global-newsletter-email');
        if (!emailInput || !(emailInput instanceof HTMLInputElement) || !emailInput.value) {
          showNewsletterMessage('error', 'Please enter your email address.');
          return;
        }

        const email = emailInput.value;
        const featureInput = newsletterForm.querySelector('input[name="feature"]');
        const feature = featureInput && featureInput instanceof HTMLInputElement ? featureInput.value : 'newsletter';

        // Show loading state
        const submitButton = document.getElementById('global-newsletter-submit');
        if (submitButton) {
          const originalButtonText = submitButton.innerHTML;
          submitButton.disabled = true;
          submitButton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Subscribing...';

          // Create form data
          const formData = new FormData();
          formData.append('email', email);
          formData.append('feature', feature);

          // Submit using fetch API
          fetch('https://api.storiesfromtheweb.org/public/save-subscriber.php', {
            method: 'POST',
            body: formData
          })
          .then(response => {
            if (!response.ok) {
              throw new Error('Network response was not ok');
            }
            return response.json();
          })
          .then(data => {
            if (data.success) {
              // Show success message
              showNewsletterMessage('success', 'Thank you for subscribing! We\'ll keep you updated with the latest news and resources.');
              // Reset form
              newsletterForm.reset();
            } else {
              showNewsletterMessage('error', data.error || 'An error occurred while subscribing. Please try again.');
            }
          })
          .catch(error => {
            console.error('Error:', error);
            showNewsletterMessage('error', 'An error occurred while subscribing. Please try again.');

            // Try a direct AJAX request as fallback
            const xhr = new XMLHttpRequest();
            xhr.open('POST', 'https://api.storiesfromtheweb.org/public/save-subscriber.php', true);
            xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
            xhr.send('email=' + encodeURIComponent(email) + '&feature=' + encodeURIComponent(feature));
          })
          .finally(() => {
            // Re-enable form elements
            submitButton.disabled = false;
            submitButton.innerHTML = originalButtonText;
          });
        }
      });
    }

    // Helper function to show success or error messages
    function showNewsletterMessage(type, message) {
      const successDiv = document.getElementById('global-newsletter-success');
      const errorDiv = document.getElementById('global-newsletter-error');

      if (successDiv && errorDiv) {
        if (type === 'success') {
          successDiv.textContent = message;
          successDiv.classList.remove('hidden');
          errorDiv.classList.add('hidden');
        } else {
          errorDiv.textContent = message;
          errorDiv.classList.remove('hidden');
          successDiv.classList.add('hidden');
        }

        // Hide the message after 5 seconds
        setTimeout(() => {
          if (type === 'success') {
            successDiv.classList.add('hidden');
          } else {
            errorDiv.classList.add('hidden');
          }
        }, 5000);
      }
    }
  });
</script>
