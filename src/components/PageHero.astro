---
import Breadcrumbs from './Breadcrumbs.astro';

interface Crumb {
  text: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  type: 'ai-tools' | 'games' | 'directories' | 'stories' | 'authors' | 'blog';
  showSearch?: boolean;
  crumbs?: Crumb[];
}

const { title, description, type, showSearch = false, crumbs = [] } = Astro.props;

// Define background colors based on page type
const backgrounds = {
  'ai-tools': 'bg-gradient-to-br from-primary-50 via-white to-tertiary-50',
  'games': 'bg-gradient-to-br from-secondary-50 via-white to-accent-50',
  'directories': 'bg-gradient-to-br from-accent-50 via-white to-primary-50',
  'stories': 'bg-gradient-to-br from-primary-50 via-white to-secondary-50',
  'authors': 'bg-gradient-to-br from-tertiary-50 via-white to-primary-50',
  'blog': 'bg-gradient-to-br from-secondary-50 via-white to-tertiary-50'
};

const background = backgrounds[type];
---

<section class={`relative pt-8 pb-16 overflow-hidden ${background}`}>
  <div class="container">
    <div class="max-w-4xl mx-auto">
      {crumbs.length > 0 && (
        <div class="mb-8">
          <Breadcrumbs crumbs={crumbs} />
        </div>
      )}
      <h1 class="text-4xl md:text-5xl font-display font-bold mb-4 text-text-primary fancy-underline transform-style-3d hover:translate-z-8 transition-transform duration-500">
        {title}
      </h1>
      {description && (
        <p class="text-lg md:text-xl max-w-3xl mb-6 text-text-secondary">
          {description}
        </p>
      )}

      {showSearch && (
        <div class="max-w-2xl mt-6">
          <div class="relative">
            <input
              type="text"
              placeholder="Search..."
              class="w-full px-4 py-3 pl-12 rounded-md border border-neutral-200 focus:outline-none focus:ring-2 focus:ring-primary/50 text-gray-800"
            />
            <div class="absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-500">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
              </svg>
            </div>
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .fancy-underline {
    position: relative;
    display: inline-block;
  }

  .fancy-underline::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -5px;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, var(--color-primary) 0%, var(--color-secondary) 50%, var(--color-accent) 100%);
    border-radius: 3px;
    transform: scaleX(0.7);
    transform-origin: center;
    transition: transform 0.5s ease;
  }

  .fancy-underline:hover::after {
    transform: scaleX(1);
  }
</style>