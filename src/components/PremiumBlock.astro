---
// Premium Block Component
// This component displays premium/sponsored blocks for the Stories Directory

import SponsoredBadge from './SponsoredBadge.astro';

interface Props {
  type?: 'sponsored' | 'editor-pick';
  title: string;
  description: string;
  image?: string;
  link?: string;
  buttonText?: string;
  buttonLink?: string;
  badgeType?: 'sponsored' | 'featured';
  comingSoon?: boolean;
}

const {
  type = 'editor-pick',
  title,
  description,
  image = 'https://api.storiesfromtheweb.org/uploads/optimized/68128956b67985-46295508-premium-reading-large.jpg',
  link = '/premium',
  buttonText = 'Learn More',
  buttonLink,
  badgeType = 'featured',
  comingSoon = true
} = Astro.props;

const typeClasses = {
  'sponsored': 'from-tertiary-100 to-tertiary-50/80 border-tertiary-200/50',
  'editor-pick': 'from-accent-100 to-accent-50/80 border-accent-200/50'
};
---

<div class={`relative rounded-xl overflow-hidden border bg-gradient-to-br ${typeClasses[type]} shadow-playful hover:shadow-xl transition-all duration-300 transform-style-3d hover:translate-z-2 group`}>
  <a href={link} class="block">
    <div class="h-96 overflow-hidden relative">
      <img
        src={image}
        alt={title}
        width="1200"
        height="800"
        class="w-full h-full object-cover"
      />
      
      {/* Dark gradient overlay */}
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent"></div>

      {/* Badges */}
      <div class="absolute top-4 right-4">
        <SponsoredBadge type={badgeType} />
      </div>

      {/* Content */}
      <div class="absolute inset-x-0 bottom-0 p-8">
        <h3 class="font-display font-bold text-3xl text-white mb-4">{title}</h3>
        <p class="text-white/90 text-xl max-w-2xl mb-6">{description}</p>

        <div class="flex items-center mt-4">
          <a href={buttonLink || link} class="bg-white text-primary hover:bg-primary hover:text-white px-6 py-3 rounded-full font-bold text-lg shadow-xl transition-all duration-300 transform hover:scale-105 hover:translate-y-[-2px] flex items-center">
            <span class="relative z-10 flex items-center">
              {buttonText}
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 ml-2 transform group-hover:translate-x-1 transition-transform">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </span>
          </a>
        </div>
      </div>

      {comingSoon && (
        <div class="absolute top-4 left-4">
          <div class="bg-accent/90 text-white px-6 py-3 rounded-xl font-bold text-lg shadow-xl backdrop-blur-sm transform rotate-2 scale-110 animate-pulse">
            <span class="flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
              </svg>
              Coming Soon
            </span>
          </div>
        </div>
      )}
    </div>
  </a>
</div>