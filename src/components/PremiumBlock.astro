---
// Premium Block Component
// This component displays premium/sponsored blocks for the Stories Directory

import SponsoredBadge from './SponsoredBadge.astro';

interface Props {
  type?: 'sponsored' | 'editor-pick';
  title: string;
  description: string;
  image?: string;
  link?: string;
  buttonText?: string;
  buttonLink?: string;
  badgeType?: 'sponsored' | 'featured';
  comingSoon?: boolean;
}

const {
  type = 'editor-pick',
  title,
  description,
  image = 'https://api.storiesfromtheweb.org/uploads/optimized/68128956b67985-46295508-premium-reading-large.jpg',
  link = '/premium/',
  buttonText = 'Learn More',
  buttonLink,
  badgeType = 'featured',
  comingSoon = true
} = Astro.props;

const typeClasses = {
  'sponsored': 'from-tertiary-100 to-tertiary-50/80 border-tertiary-200/50',
  'editor-pick': 'from-accent-100 to-accent-50/80 border-accent-200/50'
};
---

<div class={`relative rounded-xl overflow-hidden border bg-gradient-to-br ${typeClasses[type]} shadow-playful hover:shadow-xl transition-all duration-300 transform-style-3d hover:translate-z-2 group`}>
  <a href={link} class="block">
    <div class="h-200 overflow-hidden relative">
      <img
        src={image}
        alt={title}
        width="1200"
        height="800"
        class="w-full h-full object-cover"
      />

      {/* Dark gradient overlay */}
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent"></div>

      {/* Badges */}
      <div class="absolute top-4 right-4">
        <SponsoredBadge type={badgeType} />
      </div>

      {/* Content */}
      <div class="absolute inset-x-0 bottom-0 p-8">
        <h3 class="font-display font-bold text-3xl text-white mb-4">{title}</h3>
        <p class="text-white/90 text-lg md:text-xl max-w-2xl mb-6 bg-black/40 p-3 rounded-lg backdrop-blur-sm">{description}</p>

        <div class="flex items-center mt-4">
          <a href={buttonLink || link} class="bg-primary text-white hover:bg-primary-600 px-6 py-3 rounded-full font-bold text-lg shadow-xl transition-all duration-300 transform hover:scale-105 hover:translate-y-[-2px] flex items-center">
            <span class="relative z-10 flex items-center">
              {buttonText}
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 ml-2 transform group-hover:translate-x-1 transition-transform">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </span>
          </a>
        </div>
      </div>

      {comingSoon && (
        <div class="absolute top-4 right-4">
          <div class="bg-gradient-to-r from-purple-600 to-blue-500 text-white px-6 py-3 rounded-xl font-bold text-lg shadow-xl backdrop-blur-sm transform scale-110 animate-pulse-slow hover:scale-115 transition-transform duration-300">
            <span class="flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-2 animate-bounce-gentle">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" />
              </svg>
              Coming Soon
            </span>
          </div>
        </div>
      )}
    </div>
  </a>
</div>