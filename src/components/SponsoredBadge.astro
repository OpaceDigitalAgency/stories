import type { SponsoredBadgeProps } from '../types/components';

interface ExtendedSponsoredBadgeProps extends SponsoredBadgeProps {
  size?: 'sm' | 'md' | 'lg';
  type?: 'featured' | 'sponsored';
}

const { sponsor, className = '', size = 'md', type: propType } = Astro.props as ExtendedSponsoredBadgeProps;

// Determine badge type - allow explicit override via props
type BadgeType = 'featured' | 'sponsored';
const type: BadgeType = propType || (sponsor ? 'sponsored' : 'featured');

console.log("Badge type:", type, "Sponsor:", sponsor); // Debug log