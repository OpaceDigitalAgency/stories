---
import NavHeader from '../components/NavHeader.astro';
import Footer from '../components/Footer.astro';
import { getConfig } from '../lib/config';
import '../styles/base.css';

export interface Props {
  title: string;
  description?: string;
}

// Get site information from config
const siteName = getConfig('site.name', 'Stories From The Web');
const siteDescription = getConfig('site.description', "Share and discover children's stories");
const faviconPng = getConfig('site.favicon.png', '/favicon.png');

// Use props or fallback to config values
const {
  title = getConfig('site.title', `${siteName} | ${siteDescription}`),
  description = siteDescription
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="icon" type="image/x-icon" href={faviconPng}>
    <link rel="shortcut icon" type="image/x-icon" href={faviconPng}>
    
    <!-- Direct Google Fonts import instead of via CSS -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;600;700;800&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Inline critical CSS styles to ensure basics always render -->
    <style is:inline>
      /* Basic fallback styles in case Tailwind doesn't load */
      body {
        font-family: 'Nunito', sans-serif;
        color: #333;
        background-color: #f9f9f9;
        margin: 0;
        padding: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      main {
        flex-grow: 1;
        width: 100%;
      }
      h1, h2, h3, h4, h5, h6 {
        font-family: 'Poppins', sans-serif;
        color: #333;
      }
      a {
        color: #4361ee;
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }
      .container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 1rem;
        width: 100%;
      }
    </style>
    
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col bg-neutral-50 text-text-primary font-sans">
    <NavHeader />
    <main class="flex-grow w-full">
      <slot />
    </main>
    <Footer />
    <slot name="scripts" />
  </body>
</html>
