---
import NavHeader from '../components/NavHeader.astro';
import Footer from '../components/Footer.astro';
import { getConfig } from '../lib/config';
import '../styles/base.css';

export interface Props {
  title: string;
  description?: string;
}

// Get site information from config
const siteName = getConfig('site.name', 'Stories From The Web');
const siteDescription = getConfig('site.description', "Share and discover children's stories");
const faviconPng = getConfig('site.favicon.png', '/favicon.png');

// Use props or fallback to config values
const {
  title = getConfig('site.title', `${siteName} | ${siteDescription}`),
  description = siteDescription
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="icon" type="image/x-icon" href={faviconPng}>
    <link rel="shortcut icon" type="image/x-icon" href={faviconPng}>
    <meta name="generator" content={Astro.generator} />
    
    <!-- Preload Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;600;700;800&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col bg-neutral-50 text-text-primary font-sans">
    <NavHeader />
    <main class="flex-grow w-full">
      <slot />
    </main>
    <Footer />
    <slot name="scripts" />
  </body>
</html>
