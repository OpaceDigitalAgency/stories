---
import Layout from '../../layouts/Layout.astro';
import { getConfig } from '../../lib/config';
import { fetchAiTool, type AiTool } from '../../lib/api';
import ApiErrorMessage from '../../components/ApiErrorMessage.astro';

export const prerender = false;

// Get site name from config
const siteName = getConfig('site.name', 'Stories From The Web');

// Get the slug from the URL
const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/404');
}

// Initialize data
let item: AiTool | null = null;
let apiError = false;
let apiErrorDetails: Error | null = null;

try {
  // Fetch AI tool by slug
  item = await fetchAiTool(slug);
  
  if (!item) {
    return Astro.redirect('/404');
  }
} catch (err) {
  console.error('Error fetching AI tool:', err);
  apiError = true;
  apiErrorDetails = err instanceof Error ? err : new Error('An unknown error occurred');
  item = null;
}

// Page metadata
const title = item ? `${item.title} | ${siteName}` : `AI Tool Not Found | ${siteName}`;
const description = item ? item.description : `We couldn't find the AI tool you're looking for.`;
---

<Layout title={title} description={description}>
  <main class="flex-grow w-full pt-24 pb-16">
    <div class="container mx-auto px-4 max-w-4xl">
      {apiError ? (
        <section class="py-8">
          <div class="container mx-auto px-4">
            <ApiErrorMessage error={apiErrorDetails} message="We're having trouble loading this AI tool. Please try again later." />
          </div>
        </section>
      ) : !item ? (
        <section class="py-8">
          <div class="container mx-auto px-4">
            <div class="text-center">
              <h1 class="text-2xl font-bold text-text-primary mb-4">AI Tool Not Found</h1>
              <p class="text-text-secondary">The AI tool you're looking for could not be found.</p>
            </div>
          </div>
        </section>
      ) : (
        <>
          <header class="mb-8">
            <h1 class="text-4xl font-bold text-text-primary mb-4">{item.title}</h1>
            <p class="text-xl text-text-secondary">{item.category}</p>
          </header>

          <div class="prose prose-lg max-w-none">
            <div class="mb-6">
              <h2 class="text-2xl font-bold mb-2">Description</h2>
              <p>{item.description}</p>
            </div>

            <div class="mb-6">
              <h2 class="text-2xl font-bold mb-2">Pricing Type</h2>
              <p>{item.pricingType}</p>
            </div>

            {item.featured && (
              <div class="mb-6">
                <span class="inline-block bg-yellow-100 text-yellow-800 px-3 py-1 rounded-full text-sm font-medium">
                  Featured Tool
                </span>
              </div>
            )}
          </div>
        </>
      )}
    </div>
  </main>
</Layout>