---
import Layout from '../../layouts/Layout.astro';
import { getConfig } from '../../lib/config';
import { fetchAiTool, type AiTool } from '../../lib/api';
import ApiErrorMessage from '../../components/ApiErrorMessage.astro';

// Dynamic route for AI tool details

// Get site name from config
const siteName = getConfig('site.name', 'Stories From The Web');

// Get the slug from the URL
const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/404');
}

// Initialize data
let item: AiTool | null = null;
let apiError = false;
let apiErrorDetails: Error | null = null;

try {
  // Fetch AI tool by slug
  item = await fetchAiTool(slug);
  
  if (!item) {
    return Astro.redirect('/404');
  }
} catch (err) {
  console.error('Error fetching AI tool:', err);
  apiError = true;
  apiErrorDetails = err instanceof Error ? err : new Error('An unknown error occurred');
}

// Page metadata
const title = item ? `${item.name} | ${siteName}` : `AI Tool Not Found | ${siteName}`;
const description = item ? item.description : `We couldn't find the AI tool you're looking for.`;
---

<Layout title={title} description={description}>
  <main class="flex-grow w-full pt-24 pb-16">
    <div class="container mx-auto px-4 max-w-4xl">
      {apiError ? (
        <section class="py-8">
          <div class="container mx-auto px-4">
            <ApiErrorMessage error={apiErrorDetails} message="We couldn't find this AI tool. It may have been moved or deleted." />
          </div>
        </section>
      ) : item && (
        <>
          <header class="mb-8">
            <div class="flex items-center gap-6 mb-6">
              <img
                src={item.logo || '/images/default-cover.svg'}
                alt={item.name}
                class="w-24 h-24 rounded-xl object-cover shadow-md"
              />
              <div>
                <h1 class="text-4xl font-bold text-text-primary mb-2">{item.name}</h1>
                <p class="text-xl text-text-secondary">{item.category}</p>
              </div>
            </div>
            {item.url && (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center bg-primary text-white px-6 py-3 rounded-xl hover:bg-primary-600 transition-colors"
              >
                Visit Tool
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 ml-2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                </svg>
              </a>
            )}
          </header>

          <div class="prose prose-lg max-w-none">
            <div class="mb-8">
              <h2 class="text-2xl font-bold mb-4">About this Tool</h2>
              <p class="text-text-secondary">{item.description}</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
              <div>
                <h3 class="text-xl font-bold mb-2">Pricing</h3>
                <p class="text-text-secondary">
                  <span class="inline-block bg-primary/10 text-primary px-3 py-1 rounded-full text-sm font-medium mb-2">
                    {item.pricingType}
                  </span>
                  {item.priceInfo && (
                    <span class="block mt-2">{item.priceInfo}</span>
                  )}
                </p>
              </div>

              {item.features && (
                <div>
                  <h3 class="text-xl font-bold mb-2">Features</h3>
                  <p class="text-text-secondary">{item.features}</p>
                </div>
              )}
            </div>

            <div class="flex flex-wrap gap-3">
              {item.featured && (
                <span class="inline-block bg-yellow-100 text-yellow-800 px-3 py-1 rounded-full text-sm font-medium">
                  Featured Tool
                </span>
              )}
              {item.rating && (
                <span class="inline-flex items-center bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm font-medium">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-4 h-4 mr-1">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                  {item.rating} / 5
                </span>
              )}
            </div>
          </div>
        </>
      )}
    </div>
  </main>
</Layout>