---
import NavHeader from '../../components/NavHeader.astro';
import Footer from '../../components/Footer.astro';
import { fetchAiTools, type AiTool } from '../../lib/api';
import '../../styles/base.css';

export const prerender = true;

export async function getStaticPaths() {
  const tools = await fetchAiTools();
  return tools.map(tool => ({
    params: { slug: tool.slug }
  }));
}

const { slug } = Astro.params;

// Fetch all AI tools and find the one we want
const allTools = await fetchAiTools();
const tool = allTools.find(t => t.slug === slug);

if (!tool) {
  return new Response('AI tool not found', { status: 404 });
}

// Get related tools in the same category (excluding current tool)
const relatedTools = allTools
  .filter(t => t.category === tool.category && t.slug !== slug)
  .slice(0, 3);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{tool.title} | Stories From The Web</title>
    <meta name="description" content={tool.description} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://storiesfromtheweb.org/ai-tools/${slug}`} />
    <meta property="og:title" content={`${tool.title} | Stories From The Web`} />
    <meta property="og:description" content={tool.description} />
    <meta property="og:image" content={tool.coverImage} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={`https://storiesfromtheweb.org/ai-tools/${slug}`} />
    <meta property="twitter:title" content={`${tool.title} | Stories From The Web`} />
    <meta property="twitter:description" content={tool.description} />
    <meta property="twitter:image" content={tool.coverImage} />
    
    <!-- Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "${tool.title}",
        "description": "${tool.description}",
        "image": "${tool.coverImage}",
        "url": "https://storiesfromtheweb.org/ai-tools/${slug}",
        "applicationCategory": "${tool.category}",
        "offers": {
          "@type": "Offer",
          "priceCurrency": "USD",
          "price": "${tool.pricingType}"
        }
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-neutral">
    <NavHeader />
    
    <main class="flex-grow">
      <!-- AI Tool Header -->
      <div class="relative">
        <div class="absolute inset-0 bg-gradient-to-b from-black/70 to-transparent z-10"></div>
        <img 
          src={tool.coverImage} 
          alt={`Cover image for ${tool.title}`} 
          class="w-full h-64 md:h-96 object-cover"
        />
        <div class="container mx-auto px-4 relative z-20 -mt-32 md:-mt-40 pb-6">
          <div class="bg-white rounded-lg shadow-lg p-6 md:p-8">
            <div class="flex flex-col md:flex-row md:items-center justify-between mb-4">
              <div>
                <div class="mb-2">
                  <span class="inline-block px-3 py-1 bg-accent/10 text-accent rounded-full text-sm font-medium">
                    {tool.category}
                  </span>
                  {tool.featured && (
                    <span class="inline-block px-3 py-1 bg-primary/10 text-primary rounded-full text-sm font-medium ml-2">
                      Featured
                    </span>
                  )}
                </div>
                <h1 class="text-3xl md:text-4xl font-display font-bold text-gray-800 mb-2">
                  {tool.title}
                </h1>
                <div class="text-lg font-semibold text-primary">
                  {tool.pricingType}
                </div>
              </div>
            </div>
            
            <!-- Tool Description -->
            <div class="prose prose-lg max-w-none mb-8">
              <p>{tool.description}</p>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Related Tools -->
      <section class="py-12 bg-gray-50">
        <div class="container mx-auto px-4">
          <h2 class="text-2xl font-display font-bold text-gray-800 mb-8">Similar Tools in {tool.category}</h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {relatedTools.map(tool => (
              <div class="bg-white rounded-lg overflow-hidden shadow-md">
                <img 
                  src={tool.coverImage} 
                  alt={tool.title}
                  class="w-full h-48 object-cover"
                />
                <div class="p-6">
                  <div class="mb-2">
                    <span class="inline-block px-2 py-1 bg-accent/10 text-accent rounded-full text-xs font-medium">
                      {tool.category}
                    </span>
                    {tool.featured && (
                      <span class="inline-block px-2 py-1 bg-primary/10 text-primary rounded-full text-xs font-medium ml-2">
                        Featured
                      </span>
                    )}
                  </div>
                  <h3 class="text-xl font-semibold mb-2">
                    <a href={`/ai-tools/${tool.slug}`} class="text-gray-800 hover:text-primary">
                      {tool.title}
                    </a>
                  </h3>
                  <div class="text-primary font-semibold">
                    {tool.pricingType}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    </main>
    
    <Footer />
  </body>
</html>