---
import Layout from '../../../layouts/Layout.astro';
import { fetchAiTools, type AiTool as ApiAiTool, type CoverImageUrls } from '../../../lib/api';
import { getConfig } from '../../../lib/config';
import ApiErrorMessage from '../../../components/ApiErrorMessage.astro';

// Get the category from the URL
const { category } = Astro.params;

// Decode and format the category name
const decodedCategory = decodeURIComponent(category || '').split('-')
  .map(word => word.charAt(0).toUpperCase() + word.slice(1))
  .join(' ');

// Use the API AiTool interface directly
type AiTool = ApiAiTool;

// Get site name from config
const siteName = getConfig('site.name', 'Stories From The Web');

// Page metadata
const title = `${decodedCategory} AI Tools | ${siteName}`;
const description = `Explore our ${decodedCategory.toLowerCase()} AI tools designed to enhance your storytelling experience.`;

// Initialize data
let aiTools: AiTool[] = [];
let categories: string[] = ['Story Generation', 'Character Creation', 'Plot Development', 'Illustration', 'Editing'];
let apiError = false;
let apiErrorDetails: Error | null = null;

try {
  // Fetch AI tools data
  const allTools = await fetchAiTools();
  
  // Filter tools by category
  aiTools = allTools.filter(tool => 
    tool.category?.toLowerCase() === decodedCategory.toLowerCase()
  );

  // Extract unique categories from all tools
  if (allTools.length > 0) {
    const uniqueCategories = new Set<string>();
    allTools.forEach(tool => {
      if (tool.category) {
        uniqueCategories.add(tool.category);
      }
    });
    if (uniqueCategories.size > 0) {
      categories = Array.from(uniqueCategories);
    }
  }
} catch (err) {
  console.error('Error fetching AI tools data:', err);
  apiError = true;
  apiErrorDetails = err instanceof Error ? err : new Error('An unknown error occurred');
  aiTools = [];
}

---

<Layout title={title} description={description}>
  <main class="flex-grow w-full">
    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-primary/90 to-tertiary/90 text-white py-16">
      <div class="container mx-auto px-4">
        <h1 class="text-3xl md:text-4xl font-display font-bold mb-4">
          {decodedCategory} AI Tools
        </h1>
        <p class="text-lg md:text-xl max-w-3xl mb-6">
          Discover AI-powered tools specifically designed for {decodedCategory.toLowerCase()} to enhance your storytelling journey.
        </p>
      </div>
    </section>

    {apiError && (
      <section class="py-8 bg-white border-b">
        <div class="container mx-auto px-4">
          <ApiErrorMessage error={apiErrorDetails} message="We're having trouble loading AI tools data right now. Please try again later." />
        </div>
      </section>
    )}

    <!-- Categories Section -->
    <section class="py-8 bg-white border-b">
      <div class="container mx-auto px-4">
        <div class="flex flex-wrap gap-2 justify-center">
          <a href="/ai-tools" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 rounded-full text-sm font-medium transition-colors">
            All Tools
          </a>
          {categories.map(cat => (
            <a 
              href={`/ai-tools/category/${cat.toLowerCase().replace(/\s+/g, '-')}`} 
              class={`px-4 py-2 rounded-full text-sm font-medium transition-colors ${
                cat.toLowerCase() === decodedCategory.toLowerCase() 
                  ? 'bg-primary text-white' 
                  : 'bg-gray-100 hover:bg-gray-200 text-gray-800'
              }`}
            >
              {cat}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Tools Grid Section -->
    <section class="py-12">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {aiTools.length > 0 ? (
            aiTools.map(tool => (
              <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition-shadow">
                <a href={`/ai-tools/${tool.slug}`} class="block">
                  <div class="h-48 bg-gray-200">
                    <img
                      src={tool.logo || '/images/default-cover.svg'}
                      alt={tool.name}
                      class="w-full h-full object-cover"
                    />
                  </div>

                  <div class="p-6">
                    <div class="flex items-center mb-3">
                      <span class="bg-primary/10 text-primary px-2 py-1 rounded-full text-xs font-medium">
                        {tool.category || 'General'}
                      </span>
                      {tool.pricingType === 'paid' && (
                        <span class="bg-tertiary/10 text-tertiary px-2 py-1 rounded-full text-xs font-medium ml-2">
                          Premium
                        </span>
                      )}
                    </div>

                    <h3 class="text-xl font-display font-bold text-text-primary mb-3 hover:text-primary transition-colors">
                      {tool.name}
                    </h3>

                    <p class="text-text-secondary text-sm mb-4 line-clamp-3">
                      {tool.description || 'No description available.'}
                    </p>

                    <div class="flex items-center justify-between">
                      <div class="flex items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-yellow-500 mr-1">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
                        </svg>
                        <span class="text-sm font-medium">5/5</span>
                      </div>

                      <span class="text-primary hover:text-primary/80 text-sm font-medium flex items-center">
                        Try Now
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3 ml-1">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                        </svg>
                      </span>
                    </div>
                  </div>
                </a>
              </div>
            ))
          ) : (
            <div class="col-span-1 md:col-span-2 lg:col-span-3 text-center py-12">
              <p class="text-lg text-gray-600">No AI tools available in this category at the moment. Please check back later.</p>
            </div>
          )}
        </div>
      </div>
    </section>
  </main>
</Layout>