---
import Layout from '../../layouts/Layout.astro';
import { fetchAiTools, type AiTool } from '../../lib/api';
import { getConfig } from '../../lib/config';
import ApiErrorMessage from '../../components/ApiErrorMessage.astro';
import PageHero from '../../components/PageHero.astro';

// Get site name from config
const siteName = getConfig('site.name', 'Stories From The Web');

// Page metadata
const title = `AI Tools | ${siteName}`;
const description = "Enhance your creativity with our suite of AI tools designed to help you craft engaging stories for young readers.";

// Initialize data
let aiTools: AiTool[] = [];
let categories: string[] = ['Story Generation', 'Character Creation', 'Plot Development', 'Illustration', 'Editing'];
let apiError = false;
let apiErrorDetails: Error | null = null;

try {
  // Fetch AI tools data
  aiTools = await fetchAiTools();

  // Extract unique categories from AI tools
  if (aiTools.length > 0) {
    const uniqueCategories = new Set<string>();
    aiTools.forEach(tool => {
      if (tool.category) {
        uniqueCategories.add(tool.category);
      }
    });
    if (uniqueCategories.size > 0) {
      categories = Array.from(uniqueCategories);
    }
  }
} catch (err) {
  console.error('Error fetching AI tools data:', err);
  apiError = true;
  apiErrorDetails = err instanceof Error ? err : new Error('An unknown error occurred');
  aiTools = [];
}

---

<Layout title={title} description={description}>
  <main class="flex-grow w-full">
    <PageHero
      title="AI-Powered Storytelling Tools"
      description="Enhance your creativity with our suite of AI tools designed to help you craft engaging stories for young readers."
      type="ai-tools"
      showSearch={true}
    />

    <div class="container mx-auto px-4 -mt-8 mb-8 relative z-10">
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#tools" class="btn btn-accent text-lg px-6 py-3 shadow-playful btn-playful bg-white/90 backdrop-blur-sm">
          <span class="flex items-center">
            Explore Tools
          </span>
        </a>
        <a href="/publish" class="btn btn-white text-primary text-lg px-6 py-3 shadow-playful btn-playful bg-white/90 backdrop-blur-sm">
          <span class="flex items-center">
            Start Writing
          </span>
        </a>
      </div>
    </div>

      {apiError && (
        <section class="py-8 bg-white border-b">
          <div class="container mx-auto px-4">
            <ApiErrorMessage error={apiErrorDetails} message="We're having trouble loading AI tools data right now. Please try again later." />
          </div>
        </section>
      )}

      <!-- Categories Section -->
      <section class="py-8 bg-white/50 backdrop-blur-sm border-b">
        <div class="container mx-auto px-4">
          <div class="flex flex-wrap gap-2 justify-center">
            <a href="/ai-tools" class="px-4 py-2 bg-primary text-white rounded-full text-sm font-medium">
              All Tools
            </a>
            {categories.map(category => (
              <a href={`/ai-tools/category/${category.toLowerCase().replace(/\s+/g, '-')}`} class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 rounded-full text-sm font-medium transition-colors">
                {category}
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- Our AI Tools Section -->
      <section id="tools" class="py-12">
        <div class="container mx-auto px-4">
          <h2 class="text-3xl font-display font-bold text-text-primary mb-8">Our AI Tools</h2>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {aiTools.length > 0 ? (
              aiTools.map(tool => (
                <div class="bg-white/50 backdrop-blur-sm rounded-xl shadow-md overflow-hidden hover:shadow-lg transition-shadow">
                  <a href={`/ai-tools/${tool.slug}`} class="block">
                    <div class="h-48 bg-gray-200">
                      <img
                        src={tool.logo || '/images/default-cover.svg'}
                        alt={tool.name}
                        class="w-full h-full object-cover"
                      />
                    </div>

                    <div class="p-6">
                      <div class="flex items-center mb-3">
                        <span class="bg-primary/10 text-primary px-2 py-1 rounded-full text-xs font-medium">
                          {tool.category || 'General'}
                        </span>
                        {tool.pricingType === 'paid' && (
                          <span class="bg-tertiary/10 text-tertiary px-2 py-1 rounded-full text-xs font-medium ml-2">
                            Premium
                          </span>
                        )}
                      </div>

                      <h3 class="text-xl font-display font-bold text-text-primary mb-3 hover:text-primary transition-colors">
                        {tool.name}
                      </h3>

                      <p class="text-text-secondary text-sm mb-4 line-clamp-3">
                        {tool.description || 'No description available.'}
                      </p>

                      <div class="flex items-center justify-between">
                        <div class="flex items-center">
                          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-yellow-500 mr-1">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
                          </svg>
                          <span class="text-sm font-medium">5/5</span>
                        </div>

                        <span class="text-primary hover:text-primary/80 text-sm font-medium flex items-center">
                          Try Now
                          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3 ml-1">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                          </svg>
                        </span>
                      </div>
                    </div>
                  </a>
                </div>
              ))
            ) : (
              <div class="col-span-1 md:col-span-2 lg:col-span-3 text-center py-12">
                <p class="text-lg text-gray-600">No AI tools available at the moment. Please check back later.</p>
              </div>
            )}
          </div>
        </div>
      </section>

      <!-- How It Works Section -->
      <section class="py-16 bg-white/50 backdrop-blur-sm">
        <div class="container mx-auto px-4">
          <h2 class="text-3xl font-display font-bold text-text-primary mb-12 text-center">How It Works</h2>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="bg-white/80 backdrop-blur-sm rounded-xl p-6 text-center shadow-md">
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="text-2xl font-bold text-primary">1</span>
              </div>
              <h3 class="text-xl font-bold mb-3">Choose a Tool</h3>
              <p class="text-gray-600">Select from our range of AI-powered tools designed for different aspects of storytelling.</p>
            </div>

            <div class="bg-white/80 backdrop-blur-sm rounded-xl p-6 text-center shadow-md">
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="text-2xl font-bold text-primary">2</span>
              </div>
              <h3 class="text-xl font-bold mb-3">Input Your Ideas</h3>
              <p class="text-gray-600">Provide some basic information or starting points for the AI to work with.</p>
            </div>

            <div class="bg-white/80 backdrop-blur-sm rounded-xl p-6 text-center shadow-md">
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="text-2xl font-bold text-primary">3</span>
              </div>
              <h3 class="text-xl font-bold mb-3">Refine & Create</h3>
              <p class="text-gray-600">Review the AI-generated content, make edits, and create your perfect story.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Newsletter Section -->
      <section class="py-16">
        <div class="container mx-auto px-4">
          <div class="max-w-4xl mx-auto bg-gradient-to-br from-primary-50 to-primary-100 rounded-3xl p-12 shadow-xl transform-style-3d hover:translate-z-8 transition-transform duration-500 text-center">
          <h2 class="text-3xl font-display font-bold text-text-primary mb-4">Stay Updated</h2>
          <p class="text-text-secondary text-lg mb-8">
            Subscribe to our newsletter to receive updates about new AI tools and features.
          </p>

          <form id="ai-tools-newsletter-form" class="max-w-2xl mx-auto">
            <div class="flex flex-col sm:flex-row gap-3">
              <input
                type="email"
                name="email"
                id="ai-tools-newsletter-email"
                placeholder="Your email address"
                class="flex-grow px-4 py-3 rounded-xl border-2 border-neutral-dark focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-300"
                required
              />
              <input type="hidden" name="feature" value="ai-tools-updates" />
              <button
                type="submit"
                id="ai-tools-newsletter-submit"
                class="btn btn-primary px-6 py-3 shadow-playful btn-playful whitespace-nowrap"
              >
                <span class="flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 mr-2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
                  </svg>
                  Subscribe
                </span>
              </button>
            </div>
            <p class="text-sm text-gray-500 mt-3">
              We respect your privacy. Unsubscribe at any time.
            </p>
            <!-- Success message (hidden by default) -->
            <div id="ai-tools-newsletter-success" class="hidden mt-4 p-3 bg-green-100 text-green-700 rounded-lg text-center">
              Thank you for subscribing! We'll keep you updated with new AI tools and features.
            </div>
            <!-- Error message (hidden by default) -->
            <div id="ai-tools-newsletter-error" class="hidden mt-4 p-3 bg-red-100 text-red-700 rounded-lg text-center">
              There was an error processing your subscription. Please try again.
            </div>
          </form>
          </div>
        </div>
      </section>
  </main>

  <script slot="scripts">
    // AI Tools newsletter form submission
    document.addEventListener('DOMContentLoaded', function() {
      const newsletterForm = document.getElementById('ai-tools-newsletter-form');
      if (newsletterForm) {
        newsletterForm.addEventListener('submit', function(e) {
          e.preventDefault();

          // Get form data
          const emailInput = document.getElementById('ai-tools-newsletter-email');
          if (!emailInput || !(emailInput instanceof HTMLInputElement) || !emailInput.value) {
            showNewsletterMessage('error', 'Please enter your email address.');
            return;
          }

          const email = emailInput.value;
          const feature = 'ai-tools-updates';

          // Show loading state
          const submitButton = document.getElementById('ai-tools-newsletter-submit');
          if (submitButton) {
            const originalButtonText = submitButton.innerHTML;
            submitButton.disabled = true;
            submitButton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Subscribing...';

            // Create form data
            const formData = new FormData();
            formData.append('email', email);
            formData.append('feature', feature);

            // Submit using fetch API
            fetch('https://api.storiesfromtheweb.org/public/save-subscriber.php', {
              method: 'POST',
              body: formData
            })
            .then(response => {
              if (!response.ok) {
                throw new Error('Network response was not ok');
              }
              return response.json();
            })
            .then(data => {
              if (data.success) {
                // Show success message
                showNewsletterMessage('success', 'Thank you for subscribing! We\'ll keep you updated with new AI tools and features.');
                // Reset form
                newsletterForm.reset();
              } else {
                showNewsletterMessage('error', data.error || 'An error occurred while subscribing. Please try again.');
              }
            })
            .catch(error => {
              console.error('Error:', error);
              showNewsletterMessage('error', 'An error occurred while subscribing. Please try again.');

              // Try a direct AJAX request as fallback
              const xhr = new XMLHttpRequest();
              xhr.open('POST', 'https://api.storiesfromtheweb.org/public/save-subscriber.php', true);
              xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
              xhr.send('email=' + encodeURIComponent(email) + '&feature=' + encodeURIComponent(feature));
            })
            .finally(() => {
              // Re-enable form elements
              submitButton.disabled = false;
              submitButton.innerHTML = originalButtonText;
            });
          }
        });
      }

      // Helper function to show success or error messages
      function showNewsletterMessage(type, message) {
        const successDiv = document.getElementById('ai-tools-newsletter-success');
        const errorDiv = document.getElementById('ai-tools-newsletter-error');

        if (successDiv && errorDiv) {
          if (type === 'success') {
            successDiv.textContent = message;
            successDiv.classList.remove('hidden');
            errorDiv.classList.add('hidden');
          } else {
            errorDiv.textContent = message;
            errorDiv.classList.remove('hidden');
            successDiv.classList.add('hidden');
          }

          // Hide the message after 5 seconds
          setTimeout(() => {
            if (type === 'success') {
              successDiv.classList.add('hidden');
            } else {
              errorDiv.classList.add('hidden');
            }
          }, 5000);
        }
      }
    });
  </script>
</Layout>