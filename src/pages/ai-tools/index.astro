---
import NavHeader from '../../components/NavHeader.astro';
import Footer from '../../components/Footer.astro';
import { fetchAiTools, type AiTool } from '../../lib/api';
import '../../styles/base.css';

export const prerender = true;

// Fetch AI tools from API
const aiTools = await fetchAiTools();

// Define categories
const categories = [
  "Story Generation",
  "Character Creation",
  "Plot Development",
  "Illustration",
  "Educational Content",
  "Editing Tools"
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>AI-Powered Storytelling Tools | Stories From The Web</title>
    <meta name="description" content="Enhance your creativity with our suite of AI tools designed to help you craft engaging stories for young readers." />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://storiesfromtheweb.org/ai-tools" />
    <meta property="og:title" content="AI-Powered Storytelling Tools | Stories From The Web" />
    <meta property="og:description" content="Enhance your creativity with our suite of AI tools designed to help you craft engaging stories for young readers." />
    <meta property="og:image" content="https://storiesfromtheweb.org/og-image-ai-tools.jpg" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://storiesfromtheweb.org/ai-tools" />
    <meta property="twitter:title" content="AI-Powered Storytelling Tools | Stories From The Web" />
    <meta property="twitter:description" content="Enhance your creativity with our suite of AI tools designed to help you craft engaging stories for young readers." />
    <meta property="twitter:image" content="https://storiesfromtheweb.org/twitter-image-ai-tools.jpg" />
  </head>
  <body class="min-h-screen flex flex-col bg-neutral w-full">
    <NavHeader />
    
    <main class="flex-grow w-full">
      <!-- Hero Section -->
      <section class="bg-gradient-to-r from-primary/90 to-tertiary/90 text-white py-16">
        <div class="container mx-auto px-4">
          <h1 class="text-3xl md:text-4xl font-display font-bold mb-4">
            AI-Powered Storytelling Tools
          </h1>
          <p class="text-lg md:text-xl max-w-3xl mb-6">
            Enhance your creativity with our suite of AI tools designed to help you craft engaging stories for young readers.
          </p>
          
          <div class="flex flex-col sm:flex-row gap-4 mt-8">
            <a href="#tools" class="btn btn-accent text-lg px-6 py-3 shadow-playful btn-playful">
              <span class="flex items-center">
                Explore Tools
              </span>
            </a>
            <a href="/publish" class="btn btn-white bg-white text-primary text-lg px-6 py-3 shadow-playful btn-playful">
              <span class="flex items-center">
                Start Writing
              </span>
            </a>
          </div>
        </div>
      </section>
      
      <!-- Categories Section -->
      <section class="py-8 bg-white border-b">
        <div class="container mx-auto px-4">
          <div class="flex flex-wrap gap-2 justify-center">
            <a href="/ai-tools" class="px-4 py-2 bg-primary text-white rounded-full text-sm font-medium">
              All Tools
            </a>
            {categories.map(category => (
              <a href={`/ai-tools/category/${category.toLowerCase().replace(/\s+/g, '-')}`} class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 rounded-full text-sm font-medium transition-colors">
                {category}
              </a>
            ))}
          </div>
        </div>
      </section>
      
      <!-- Our AI Tools Section -->
      <section id="tools" class="py-12">
        <div class="container mx-auto px-4">
          <h2 class="text-3xl font-display font-bold text-text-primary mb-8">Our AI Tools</h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {aiTools.map(tool => (
              <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition-shadow">
                <a href={`/ai-tools/${tool.slug}`} class="block">
                  <div class="h-48 bg-gray-200">
                    <img 
                      src={tool.coverImage} 
                      alt={tool.title} 
                      class="w-full h-full object-cover"
                    />
                  </div>
                  
                  <div class="p-6">
                    <div class="flex items-center mb-3">
                      <span class="bg-primary/10 text-primary px-2 py-1 rounded-full text-xs font-medium">
                        {tool.category}
                      </span>
                      {tool.isPremium && (
                        <span class="bg-tertiary/10 text-tertiary px-2 py-1 rounded-full text-xs font-medium ml-2">
                          Premium
                        </span>
                      )}
                    </div>
                    
                    <h3 class="text-xl font-display font-bold text-text-primary mb-3 hover:text-primary transition-colors">
                      {tool.title}
                    </h3>
                    
                    <p class="text-text-secondary text-sm mb-4 line-clamp-3">
                      {tool.description}
                    </p>
                    
                    <div class="flex items-center justify-between">
                      <div class="flex items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-yellow-500 mr-1">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
                        </svg>
                        <span class="text-sm font-medium">{tool.rating}/5</span>
                      </div>
                      
                      <span class="text-primary hover:text-primary/80 text-sm font-medium flex items-center">
                        Try Now
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3 ml-1">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                        </svg>
                      </span>
                    </div>
                  </div>
                </a>
              </div>
            ))}
          </div>
        </div>
      </section>
      
      <!-- How It Works Section -->
      <section class="py-16 bg-neutral-dark">
        <div class="container mx-auto px-4">
          <h2 class="text-3xl font-display font-bold text-text-primary mb-12 text-center">How It Works</h2>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="bg-white rounded-xl p-6 text-center">
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="text-2xl font-bold text-primary">1</span>
              </div>
              <h3 class="text-xl font-bold mb-3">Choose a Tool</h3>
              <p class="text-gray-600">Select from our range of AI-powered tools designed for different aspects of storytelling.</p>
            </div>
            
            <div class="bg-white rounded-xl p-6 text-center">
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="text-2xl font-bold text-primary">2</span>
              </div>
              <h3 class="text-xl font-bold mb-3">Input Your Ideas</h3>
              <p class="text-gray-600">Provide some basic information or starting points for the AI to work with.</p>
            </div>
            
            <div class="bg-white rounded-xl p-6 text-center">
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="text-2xl font-bold text-primary">3</span>
              </div>
              <h3 class="text-xl font-bold mb-3">Refine & Create</h3>
              <p class="text-gray-600">Review the AI-generated content, make edits, and create your perfect story.</p>
            </div>
          </div>
        </div>
      </section>
      
      <!-- Newsletter Section -->
      <section class="py-16 bg-gradient-to-r from-primary/10 to-tertiary/10">
        <div class="container mx-auto px-4 max-w-4xl text-center">
          <h2 class="text-3xl font-display font-bold text-text-primary mb-4">Stay Updated</h2>
          <p class="text-text-secondary text-lg mb-8">
            Subscribe to our newsletter to receive updates about new AI tools and features.
          </p>
          
          <form class="max-w-2xl mx-auto">
            <div class="flex flex-col sm:flex-row gap-3">
              <input
                type="email"
                placeholder="Your email address"
                class="flex-grow px-4 py-3 rounded-xl border-2 border-neutral-dark focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-300"
                required
              />
              <button
                type="submit"
                class="btn btn-primary px-6 py-3 shadow-playful btn-playful whitespace-nowrap"
              >
                <span class="flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 mr-2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
                  </svg>
                  Subscribe
                </span>
              </button>
            </div>
            <p class="text-sm text-gray-500 mt-3">
              We respect your privacy. Unsubscribe at any time.
            </p>
          </form>
        </div>
      </section>
    </main>
    
    <Footer />
  </body>
</html>