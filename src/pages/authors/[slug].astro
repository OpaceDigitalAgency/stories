---
import Layout from '../../layouts/Layout.astro';
import CardStory from '../../components/CardStory.astro';
import TagBadge from '../../components/TagBadge.astro';
import ReviewSection from '../../components/ReviewSection.astro';
import SponsoredBadge from '../../components/SponsoredBadge.astro';
import ApiErrorMessage from '../../components/ApiErrorMessage.astro';
import { fetchAuthor, fetchStories, type Author, type Story } from '../../lib/api';
import { getConfig } from '../../lib/config';

// Get the slug from the URL
const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/404');
}

// Get site name from config
const siteName = getConfig('site.name', 'Stories From The Web');

// Initialize data
let author: Author | null = null;
let authorStories: Story[] = [];
let popularTags: string[] = [];
let apiError = false;
let apiErrorDetails: Error | null = null;

try {
  // Fetch author and their stories
  const [authorData, storiesData] = await Promise.all([
    fetchAuthor(slug),
    fetchStories(1, 50, { sort: 'publishedAt:desc' })
  ]);

  author = authorData;
  if (!author) {
    return Astro.redirect('/404');
  }

  // Filter stories by author
  authorStories = storiesData.filter(story => story.author?.slug === slug);

  // Extract popular tags from author's stories
  const tagCounts = new Map<string, number>();
  authorStories.forEach(story => {
    story.tags?.forEach(tag => {
      tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
    });
  });

  // Get top 5 most used tags
  popularTags = Array.from(tagCounts.entries())
    .sort((a, b) => b[1] - a[1])
    .slice(0, 5)
    .map(([tag]) => tag);

} catch (err) {
  console.error('Error fetching author data:', err);
  apiError = true;
  apiErrorDetails = err instanceof Error ? err : new Error('An unknown error occurred');
  author = null;
  authorStories = [];
  popularTags = [];
  return Astro.redirect('/404');
}

// Page metadata
const title = author ? `${author.name} | ${siteName}` : siteName;
const description = author?.bio || `Read stories by ${author?.name} on ${siteName}`;
---

<Layout title={title} description={description}>
  <main class="flex-grow w-full">
    {apiError ? (
      <section class="py-8">
        <div class="container mx-auto px-4">
          <ApiErrorMessage error={apiErrorDetails} message="We're having trouble loading this author's profile. Please try again later." />
        </div>
      </section>
    ) : author ? (
    <!-- Author Header -->
    <section class="relative py-16 overflow-hidden">
      <!-- Enhanced decorative blobs -->
      <div class="absolute -top-32 -right-32 w-[32rem] h-[32rem] bg-primary-200/30 rounded-full blur-3xl animate-blob"></div>
      <div class="absolute -bottom-32 -left-32 w-[32rem] h-[32rem] bg-secondary-200/30 rounded-full blur-3xl animate-blob animation-delay-2000"></div>
      <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[32rem] h-[32rem] bg-accent-200/20 rounded-full blur-3xl animate-blob animation-delay-4000"></div>

      <div class="container relative z-10">
        <div class="max-w-4xl mx-auto">
          <div class="flex flex-col md:flex-row items-center md:items-start gap-8 mb-12">
            <!-- Author Avatar -->
            <div class="w-40 h-40 rounded-full overflow-hidden border-4 border-white shadow-xl transform-style-3d hover:translate-z-8 transition-transform duration-500">
              <img
                src={author.avatar || '/images/default-avatar.svg'}
                alt={author.name}
                class="w-full h-full object-cover"
              />
            </div>

            <div class="flex-1 text-center md:text-left">
              <!-- Author Name -->
              <div class="flex flex-wrap items-center justify-center md:justify-start gap-3 mb-4">
                <h1 class="text-4xl md:text-5xl font-display font-bold text-text-primary fancy-underline transform-style-3d hover:translate-z-8 transition-transform duration-500">
                  {author.name}
                </h1>

                {author.featured && (
                  <div>
                    <SponsoredBadge type="featured" />
                  </div>
                )}
              </div>

              <!-- Author Stats -->
              <div class="flex flex-wrap justify-center md:justify-start gap-6 mb-6 text-text-secondary">
                <div class="flex items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                  </svg>
                  <span>{authorStories.length} Stories</span>
                </div>

                {author.storyCount && (
                  <div class="flex items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <span>{author.storyCount.toLocaleString()} Views</span>
                  </div>
                )}

                {author.joinDate && (
                  <div class="flex items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                    </svg>
                    <span>Joined {new Date(author.joinDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}</span>
                  </div>
                )}
              </div>

              <!-- Author Bio -->
              {author.bio && (
                <p class="text-lg text-text-secondary mb-6">
                  {author.bio}
                </p>
              )}

              <!-- Social Links -->
              {author.socialLinks && (
                <div class="flex flex-wrap justify-center md:justify-start gap-4">
                  {author.socialLinks.twitter && (
                    <a
                      href={author.socialLinks.twitter}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="bg-blue-400 text-white p-3 rounded-full hover:bg-blue-500 transition-colors duration-300 transform-style-3d hover:translate-z-4 hover:scale-110 transition-transform duration-500"
                      aria-label="Twitter"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/>
                      </svg>
                    </a>
                  )}

                  {author.socialLinks.instagram && (
                    <a
                      href={author.socialLinks.instagram}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="bg-pink-500 text-white p-3 rounded-full hover:bg-pink-600 transition-colors duration-300 transform-style-3d hover:translate-z-4 hover:scale-110 transition-transform duration-500"
                      aria-label="Instagram"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                      </svg>
                    </a>
                  )}

                  {author.socialLinks.website && (
                    <a
                      href={author.socialLinks.website}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="bg-gray-700 text-white p-3 rounded-full hover:bg-gray-800 transition-colors duration-300 transform-style-3d hover:translate-z-4 hover:scale-110 transition-transform duration-500"
                      aria-label="Website"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
                      </svg>
                    </a>
                  )}
                </div>
              )}
            </div>
          </div>

          <!-- Popular Tags -->
          {popularTags.length > 0 && (
            <div class="mb-12">
              <h2 class="text-xl font-bold text-text-primary mb-4">Popular Topics</h2>
              <div class="flex flex-wrap gap-3">
                {popularTags.map(tag => (
                  <TagBadge tag={tag} size="md" />
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- Author's Stories -->
    <section class="py-16 bg-white">
      <div class="container">
        <h2 class="text-3xl font-display font-bold mb-12 text-text-primary fancy-underline transform-style-3d hover:translate-z-8 transition-transform duration-500">
          Stories by {author.name}
        </h2>

        {authorStories.length > 0 ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 perspective-1000">
            {authorStories.map((story, index) => (
              <div
                class="transform-style-3d hover:translate-z-8 transition-transform duration-700"
                style={`animation: fadeInUp 0.7s ease-out forwards ${index * 0.15}s;`}
              >
                <CardStory story={story} className="rounded-xl shadow-md hover:shadow-lg transition" />
              </div>
            ))}
          </div>
        ) : (
          <div class="text-center py-24 bg-white/70 backdrop-blur-xl rounded-3xl border border-neutral-200/50 shadow-playful transform-style-3d hover:translate-z-4 transition-transform duration-500">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-16 h-16 mx-auto mb-6 text-text-secondary/50 animate-pulse-subtle"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
            </svg>
            <p class="text-text-secondary font-bold text-xl mb-3">No stories available at the moment.</p>
            <p class="text-text-secondary/70 text-lg">Check back soon for new stories from this author!</p>
          </div>
        )}
      </div>
    </section>

    <!-- Reviews Section - Only show for non-child authors -->
    {author.author_type !== 'child' && (
      <section class="py-16">
        <div class="container">
          <div class="max-w-4xl mx-auto">
            <ReviewSection
              itemType="author"
              itemId={author.id || slug}
              itemName={author.name}
              authorType={author.author_type || 'retail'}
            />
          </div>
        </div>
      </section>
    )}
    ) : (
      <section class="py-8">
        <div class="container mx-auto px-4">
          <div class="text-center">
            <h1 class="text-2xl font-bold text-text-primary mb-4">Author Not Found</h1>
            <p class="text-text-secondary">The author you're looking for could not be found.</p>
          </div>
        </div>
      </section>
    )}
  </main>
  <style slot="scripts">
    
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(40px) scale(0.95);
      }
      50% {
        opacity: 0.5;
        transform: translateY(20px) scale(0.97);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .fancy-underline {
      position: relative;
      display: inline-block;
    }

    .fancy-underline::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: -5px;
      width: 100%;
      height: 3px;
      background: linear-gradient(90deg, var(--color-primary) 0%, var(--color-secondary) 50%, var(--color-accent) 100%);
      border-radius: 3px;
      transform: scaleX(0.7);
      transform-origin: center;
      transition: transform 0.5s ease;
    }

    .fancy-underline:hover::after {
      transform: scaleX(1);
    }
  
  </style>
</Layout>