rc/pages/blog/index.astro</path>
<content lines="79-93">
      <!-- Categories Section -->
      <section class="py-8 bg-white border-b">
        <div class="container mx-auto px-4">
          <div class="flex flex-wrap gap-2 justify-center">
            <a href="/blog" class="px-4 py-2 bg-primary text-white rounded-full text-sm font-medium">
              All Posts
            </a>
            {categories.length > 0 ? (
              categories.map(category => (
                <a href={`/blog/category/${category.name?.toLowerCase().replace(/\s+/g, '-') || 'uncategorized'}`} class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 rounded-full text-sm font-medium transition-colors">
                  {category.name || 'Uncategorized'}
                </a>
              ))
            ) : (
              <span class="px-4 py-2 bg-gray-100 text-gray-500 rounded-full text-sm font-medium">No categories available</span>
            )}
          </div>
        </div>
      </section>