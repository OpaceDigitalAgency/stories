---
import NavHeader from '../../components/NavHeader.astro';
import Footer from '../../components/Footer.astro';
import TagBadge from '../../components/TagBadge.astro';
import { fetchStories } from '../../lib/api';
import '../../styles/base.css';

// Fetch all stories to extract tags
const stories = await fetchStories(1, 100);

// Extract all tags from stories
const allTags = stories.flatMap(story => story.tags || []);

// Process tags to ensure they're strings and count occurrences
const tagCounts = {};
allTags.forEach(tag => {
  if (!tag) return;

  let tagName = '';
  if (typeof tag === 'string') {
    tagName = tag;
  } else if (tag && typeof tag === 'object' && (tag.name || tag.title)) {
    tagName = tag.name || tag.title;
  } else {
    return; // Skip invalid tags
  }

  tagCounts[tagName] = (tagCounts[tagName] || 0) + 1;
});

// Convert to array and sort by popularity
const sortedTags = Object.entries(tagCounts)
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count);

// Group stories by author type
const childAuthorStories = stories.filter(story =>
  story.author && story.author.author_type === 'child'
);
const parentAuthorStories = stories.filter(story =>
  story.author && story.author.author_type === 'parent'
);
const retailAuthorStories = stories.filter(story =>
  story.author && story.author.author_type === 'retail'
);

// Page metadata
const title = 'Categories | Stories From The Web';
const description = 'Browse stories by category or tag. Filter by author type to find exactly what you\'re looking for.';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <style>
      .tag-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 1rem;
      }
      .tag-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .count-badge {
        background-color: #f3f4f6;
        color: #4b5563;
        border-radius: 9999px;
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
        font-weight: 600;
      }
      .filter-active {
        background-color: #8b5cf6;
        color: white;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-neutral-50 text-text-primary font-sans">
    <NavHeader />

    <main class="flex-grow w-full">
      <div class="container mx-auto px-4 py-8">
        <header class="mb-8">
          <h1 class="text-3xl font-bold text-text-primary mb-2">
            Categories
          </h1>
          <p class="text-text-secondary">
            Browse stories by category or tag. Click on any tag to see related stories.
          </p>
        </header>

        <!-- Author Type Filter -->
        <div class="mb-8">
          <h2 class="text-xl font-semibold mb-4">Filter by Author Type</h2>
          <div class="flex flex-wrap gap-3">
            <button id="all-authors" class="px-4 py-2 rounded-lg bg-purple-100 text-purple-700 font-medium filter-active">
              All Authors
            </button>
            <button id="child-authors" class="px-4 py-2 rounded-lg bg-gray-100 text-gray-700 font-medium">
              Child Authors ({childAuthorStories.length})
            </button>
            <button id="parent-authors" class="px-4 py-2 rounded-lg bg-gray-100 text-gray-700 font-medium">
              Parent Authors ({parentAuthorStories.length})
            </button>
            <button id="retail-authors" class="px-4 py-2 rounded-lg bg-gray-100 text-gray-700 font-medium">
              Retail Authors ({retailAuthorStories.length})
            </button>
          </div>
        </div>

        <!-- Tags Section -->
        <section>
          <h2 class="text-xl font-semibold mb-4">All Categories</h2>
          <div class="tag-grid">
            {sortedTags.map(tag => (
              <div class="tag-item bg-white p-4 rounded-lg shadow-sm hover:shadow-md transition-shadow cursor-pointer"
                   data-tag={tag.name}
                   onclick="filterStories(currentAuthorType, this.dataset.tag)">
                <TagBadge tag={tag.name} />
                <span class="count-badge">{tag.count}</span>
              </div>
            ))}
          </div>
        </section>

        <!-- Stories Section (initially hidden, shown when filtering) -->
        <section id="filtered-stories" class="mt-10 hidden">
          <h2 class="text-xl font-semibold mb-4">Filtered Stories</h2>
          <div id="stories-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Stories will be inserted here via JavaScript -->
          </div>
        </section>
      </div>
    </main>

    <Footer />

    <script>
      // Store all stories data for client-side filtering
      const allStories = JSON.parse(`{JSON.stringify(stories)}`);

      // Author type filter buttons
      const allAuthorsBtn = document.getElementById('all-authors');
      const childAuthorsBtn = document.getElementById('child-authors');
      const parentAuthorsBtn = document.getElementById('parent-authors');
      const retailAuthorsBtn = document.getElementById('retail-authors');

      // Stories container
      const filteredStoriesSection = document.getElementById('filtered-stories');
      const storiesContainer = document.getElementById('stories-container');

      // Current filter state
      let currentAuthorType = 'all';
      let currentTag = null;

      // Show all stories by default when page loads
      window.addEventListener('DOMContentLoaded', () => {
        filterStories('all', null);
      });

      // Add click event to all tag badges
      document.querySelectorAll('[data-tag]').forEach(tagElement => {
        tagElement.addEventListener('click', (e) => {
          e.preventDefault();
          const tag = e.currentTarget.getAttribute('data-tag');
          filterStories(currentAuthorType, tag);
        });
      });

      // Add click events to author type buttons
      allAuthorsBtn.addEventListener('click', () => {
        setActiveAuthorFilter('all');
        filterStories('all', currentTag);
      });

      childAuthorsBtn.addEventListener('click', () => {
        setActiveAuthorFilter('child');
        filterStories('child', currentTag);
      });

      parentAuthorsBtn.addEventListener('click', () => {
        setActiveAuthorFilter('parent');
        filterStories('parent', currentTag);
      });

      retailAuthorsBtn.addEventListener('click', () => {
        setActiveAuthorFilter('retail');
        filterStories('retail', currentTag);
      });

      // Set active author filter button
      function setActiveAuthorFilter(type) {
        // Remove active class from all buttons
        [allAuthorsBtn, childAuthorsBtn, parentAuthorsBtn, retailAuthorsBtn].forEach(btn => {
          btn.classList.remove('filter-active');
          btn.classList.remove('bg-purple-100', 'text-purple-700');
          btn.classList.add('bg-gray-100', 'text-gray-700');
        });

        // Add active class to selected button
        currentAuthorType = type;
        let activeBtn;

        switch(type) {
          case 'child':
            activeBtn = childAuthorsBtn;
            break;
          case 'parent':
            activeBtn = parentAuthorsBtn;
            break;
          case 'retail':
            activeBtn = retailAuthorsBtn;
            break;
          default:
            activeBtn = allAuthorsBtn;
        }

        activeBtn.classList.add('filter-active');
        activeBtn.classList.remove('bg-gray-100', 'text-gray-700');
        activeBtn.classList.add('bg-purple-100', 'text-purple-700');
      }

      // Filter stories by author type and tag
      function filterStories(authorType, tag) {
        currentAuthorType = authorType;
        currentTag = tag;

        // Filter stories
        let filtered = [...allStories];

        // Filter by author type if not 'all'
        if (authorType !== 'all') {
          filtered = filtered.filter(story =>
            story.author && story.author.author_type === authorType
          );
        }

        // Filter by tag if provided
        if (tag) {
          filtered = filtered.filter(story => {
            if (!story.tags || !Array.isArray(story.tags)) return false;

            return story.tags.some(storyTag => {
              if (typeof storyTag === 'string') {
                return storyTag.toLowerCase() === tag.toLowerCase();
              } else if (storyTag && typeof storyTag === 'object') {
                const tagName = storyTag.name || storyTag.title || '';
                return tagName.toLowerCase() === tag.toLowerCase();
              }
              return false;
            });
          });
        }

        // Show filtered stories
        displayFilteredStories(filtered, tag);
      }

      // Display filtered stories
      function displayFilteredStories(stories, tag) {
        // Clear container
        storiesContainer.innerHTML = '';

        // Show/hide section based on results
        if (stories.length === 0) {
          filteredStoriesSection.classList.add('hidden');
          return;
        }

        // Update section title if filtering by tag
        const sectionTitle = filteredStoriesSection.querySelector('h2');
        if (tag) {
          sectionTitle.textContent = `Stories Tagged with "${tag}"`;
        } else {
          sectionTitle.textContent = 'Filtered Stories';
        }

        // Show section
        filteredStoriesSection.classList.remove('hidden');

        // Create story cards
        stories.forEach(story => {
          const card = document.createElement('div');
          card.className = 'bg-white rounded-xl overflow-hidden shadow-md hover:shadow-lg transition-all duration-300';

          const coverUrl = story.coverUrl || 'https://via.placeholder.com/400x250?text=No+Image';
          const title = story.title || 'Untitled Story';
          const excerpt = story.excerpt || 'No description available.';
          const authorName = story.author ? story.author.name : 'Unknown Author';
          const storyUrl = `/stories/${story.slug}`;

          card.innerHTML = `
            <a href="${storyUrl}" class="block">
              <div class="relative h-48 overflow-hidden">
                <img src="${coverUrl}" alt="${title}" class="w-full h-full object-cover transition-transform duration-500 hover:scale-110">
              </div>
              <div class="p-4">
                <h3 class="text-lg font-bold mb-2 line-clamp-2">${title}</h3>
                <p class="text-sm text-gray-600 mb-3 line-clamp-3">${excerpt}</p>
                <p class="text-xs text-gray-500">By ${authorName}</p>
              </div>
            </a>
          `;

          storiesContainer.appendChild(card);
        });
      }
    </script>
  </body>
</html>
