---
import Layout from '../layouts/Layout.astro';
import ComingSoonPage from '../components/ComingSoonPage.astro';
import { getConfig } from '../lib/config';

// Get site name from config
const siteName = getConfig('site.name', 'Stories From The Web');

// Page metadata
const title = siteName;

---

<Layout title={title} description={description}>
  <main class="flex-grow w-full">
    <ComingSoonPage
      title={featureName}
      description={`We're working hard to bring you ${featureName}. This section is currently under development and will be available soon.`}
      featureName={featureName}
      signupEnabled={true}
      image="https://api.storiesfromtheweb.org/uploads/optimized/68128956b67985-46295508-premium-reading-large.jpg"
      ctaText="Back to Home"
      ctaLink="/"
    />
  </main>
</Layout>