---
import NavHeader from '../components/NavHeader.astro';
import Footer from '../components/Footer.astro';
import '../styles/base.css';

// Page metadata
const title = 'Contact Us | Stories From The Web';
const description = 'Get in touch with the Stories From The Web team. We\'re here to help with any questions, feedback, or support you may need.';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-screen flex flex-col bg-neutral-50 text-text-primary font-sans">
    <NavHeader />
    
    <main class="flex-grow w-full">
      <div class="container mx-auto px-4 py-8 max-w-4xl">
        <header class="mb-8 text-center">
          <h1 class="text-4xl font-bold text-text-primary mb-4">
            Contact Us
          </h1>
          <p class="text-xl text-text-secondary">
            We'd love to hear from you
          </p>
        </header>

        <div class="grid md:grid-cols-2 gap-8 mb-12">
          <!-- Contact Form -->
          <div class="bg-white rounded-xl shadow-md p-8">
            <h2 class="text-2xl font-bold mb-6">Send Us a Message</h2>
            
            <form id="contact-form" class="space-y-6">
              <div>
                <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Your Name</label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  required 
                  class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-primary focus:border-primary"
                  placeholder="Enter your name"
                />
              </div>
              
              <div>
                <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email Address</label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required 
                  class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-primary focus:border-primary"
                  placeholder="Enter your email"
                />
              </div>
              
              <div>
                <label for="subject" class="block text-sm font-medium text-gray-700 mb-1">Subject</label>
                <select 
                  id="subject" 
                  name="subject" 
                  required 
                  class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-primary focus:border-primary"
                >
                  <option value="" disabled selected>Select a subject</option>
                  <option value="general">General Inquiry</option>
                  <option value="support">Technical Support</option>
                  <option value="feedback">Feedback</option>
                  <option value="partnership">Partnership Opportunity</option>
                  <option value="content">Content Question</option>
                  <option value="other">Other</option>
                </select>
              </div>
              
              <div>
                <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Message</label>
                <textarea 
                  id="message" 
                  name="message" 
                  rows="5" 
                  required 
                  class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-primary focus:border-primary"
                  placeholder="Enter your message"
                ></textarea>
              </div>
              
              <div class="flex items-start">
                <input 
                  type="checkbox" 
                  id="privacy" 
                  name="privacy" 
                  required 
                  class="mt-1 h-4 w-4 text-primary focus:ring-primary border-gray-300 rounded"
                />
                <label for="privacy" class="ml-2 block text-sm text-gray-700">
                  I agree to the <a href="/privacy" class="text-primary hover:underline">Privacy Policy</a> and consent to being contacted regarding my inquiry.
                </label>
              </div>
              
              <div>
                <button 
                  type="submit" 
                  class="w-full bg-primary text-white py-3 px-6 rounded-md font-semibold hover:bg-primary-dark transition-colors"
                >
                  Send Message
                </button>
              </div>
            </form>
            
            <!-- Success Message (hidden by default) -->
            <div id="success-message" class="hidden mt-6 p-4 bg-green-100 text-green-700 rounded-md">
              <p class="font-medium">Thank you for your message!</p>
              <p>We've received your inquiry and will get back to you as soon as possible.</p>
            </div>
          </div>
          
          <!-- Contact Information -->
          <div>
            <div class="bg-white rounded-xl shadow-md p-8 mb-8">
              <h2 class="text-2xl font-bold mb-6">Contact Information</h2>
              
              <div class="space-y-6">
                <div class="flex items-start">
                  <div class="bg-primary/20 p-2 rounded-full mr-4 mt-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-lg font-semibold">Email</h3>
                    <p class="text-gray-600">info@storiesfromtheweb.org</p>
                    <p class="text-sm text-gray-500 mt-1">For general inquiries and support</p>
                  </div>
                </div>
                
                <div class="flex items-start">
                  <div class="bg-primary/20 p-2 rounded-full mr-4 mt-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-lg font-semibold">Phone</h3>
                    <p class="text-gray-600">+44 (0)123 456 7890</p>
                    <p class="text-sm text-gray-500 mt-1">Monday to Friday, 9am - 5pm GMT</p>
                  </div>
                </div>
                
                <div class="flex items-start">
                  <div class="bg-primary/20 p-2 rounded-full mr-4 mt-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-lg font-semibold">Address</h3>
                    <p class="text-gray-600">123 Story Lane</p>
                    <p class="text-gray-600">Birmingham, B1 2AB</p>
                    <p class="text-gray-600">United Kingdom</p>
                  </div>
                </div>
              </div>
            </div>
            
            <div class="bg-white rounded-xl shadow-md p-8">
              <h2 class="text-2xl font-bold mb-6">Connect With Us</h2>
              
              <div class="space-y-4">
                <p class="mb-4">
                  Follow us on social media for updates, writing prompts, and to join our community of young writers and readers.
                </p>
                
                <div class="flex space-x-4">
                  <a href="https://twitter.com/storiesfromtheweb" target="_blank" rel="noopener noreferrer" class="bg-gray-100 hover:bg-gray-200 p-3 rounded-full transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-700" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/>
                    </svg>
                  </a>
                  
                  <a href="https://facebook.com/storiesfromtheweb" target="_blank" rel="noopener noreferrer" class="bg-gray-100 hover:bg-gray-200 p-3 rounded-full transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-700" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/>
                    </svg>
                  </a>
                  
                  <a href="https://instagram.com/storiesfromtheweb" target="_blank" rel="noopener noreferrer" class="bg-gray-100 hover:bg-gray-200 p-3 rounded-full transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-700" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- FAQ Section -->
        <div class="bg-white rounded-xl shadow-md p-8 mb-8">
          <h2 class="text-2xl font-bold mb-6">Frequently Asked Questions</h2>
          
          <div class="space-y-4">
            <details class="group">
              <summary class="flex justify-between items-center p-4 cursor-pointer bg-gray-50 rounded-lg">
                <h3 class="text-lg font-semibold">How long does it take to get a response?</h3>
                <span class="text-primary group-open:rotate-180 transition-transform">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <div class="p-4 text-gray-600">
                <p>We aim to respond to all inquiries within 1-2 business days. For urgent matters, please indicate this in the subject line of your message.</p>
              </div>
            </details>
            
            <details class="group">
              <summary class="flex justify-between items-center p-4 cursor-pointer bg-gray-50 rounded-lg">
                <h3 class="text-lg font-semibold">How can I report inappropriate content?</h3>
                <span class="text-primary group-open:rotate-180 transition-transform">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <div class="p-4 text-gray-600">
                <p>You can report inappropriate content using the "Report" button available on all content pages. Alternatively, you can email us at moderation@storiesfromtheweb.org with details of the content in question.</p>
              </div>
            </details>
            
            <details class="group">
              <summary class="flex justify-between items-center p-4 cursor-pointer bg-gray-50 rounded-lg">
                <h3 class="text-lg font-semibold">How can I become a partner?</h3>
                <span class="text-primary group-open:rotate-180 transition-transform">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <div class="p-4 text-gray-600">
                <p>We welcome partnerships with schools, libraries, publishers, and other organizations that share our mission. Please contact us at partnerships@storiesfromtheweb.org with information about your organization and how you'd like to collaborate.</p>
              </div>
            </details>
            
            <details class="group">
              <summary class="flex justify-between items-center p-4 cursor-pointer bg-gray-50 rounded-lg">
                <h3 class="text-lg font-semibold">Can I request a feature or suggest an improvement?</h3>
                <span class="text-primary group-open:rotate-180 transition-transform">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <div class="p-4 text-gray-600">
                <p>Absolutely! We value user feedback and are always looking to improve our platform. Please use the contact form above and select "Feedback" as the subject to share your ideas with us.</p>
              </div>
            </details>
          </div>
        </div>
      </div>
    </main>
    
    <Footer />

    <script>
      // Simple form handling
      document.getElementById('contact-form').addEventListener('submit', function(e) {
        e.preventDefault();
        
        // In a real implementation, you would send the form data to your backend
        // For now, we'll just show the success message
        document.getElementById('contact-form').style.display = 'none';
        document.getElementById('success-message').style.display = 'block';
        
        // Reset form
        this.reset();
      });
    </script>
  </body>
</html>
