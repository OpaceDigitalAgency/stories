---
import Layout from '../../layouts/Layout.astro';
import { getConfig } from '../../lib/config';
import { fetchDirectoryItems, type DirectoryItem } from '../../lib/api';

export const prerender = false;

// Get site name from config
const siteName = getConfig('site.name', 'Stories From The Web');

// Get the slug from the URL
const { slug } = Astro.params;

// Fetch data based on slug
let item: DirectoryItem | null = null;
let error = null;

try {
  // Fetch all directory items and find the one with the matching slug
  const items = await fetchDirectoryItems();
  item = items.find(i => i.slug === slug) || null;

  if (!item) {
    error = "Directory item not found";
  }
} catch (e) {
  error = e instanceof Error ? e.message : "An error occurred";
}

// Page metadata
const title = item ? `${item.title} | ${siteName}` : `Directory Item Not Found | ${siteName}`;
const description = item ? item.description : `We couldn't find the directory item you're looking for.`;
---

<Layout title={title} description={description}>
  <main class="flex-grow w-full pt-24 pb-16">
    <div class="container mx-auto px-4 max-w-4xl">
      {error || !item ? (
        <div class="bg-red-50 border border-red-200 rounded-lg p-6 text-center">
          <h1 class="text-3xl font-bold text-red-600 mb-4">Item Not Found</h1>
          <p class="text-lg text-red-700 mb-6">
            We couldn't find the item you're looking for. It may have been removed or the URL might be incorrect.
          </p>
          <a href="/" class="inline-block bg-primary text-white font-medium py-2 px-6 rounded-lg hover:bg-primary-dark transition-colors">
            Return to Home
          </a>
        </div>
      ) : (
        <>
          <header class="mb-8">
            <h1 class="text-4xl font-bold text-text-primary mb-4">{item.title}</h1>
            <p class="text-xl text-text-secondary">{item.category}</p>
          </header>

          <div class="prose prose-lg max-w-none">
            <div class="mb-6">
              <h2 class="text-2xl font-bold mb-2">Description</h2>
              <p>{item.description}</p>
            </div>

            <div class="mb-6">
              <h2 class="text-2xl font-bold mb-2">Price Range</h2>
              <p>{item.priceRange}</p>
            </div>

            <div class="mb-6">
              <h2 class="text-2xl font-bold mb-2">Rating</h2>
              <div class="flex items-center">
                <span class="text-yellow-500 mr-2">★</span>
                <span>{item.rating} / 5</span>
              </div>
            </div>
          </div>
        </>
      )}
    </div>
  </main>
</Layout>