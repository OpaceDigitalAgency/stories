---
import NavHeader from '../../components/NavHeader.astro';
import Footer from '../../components/Footer.astro';
import RatingStars from '../../components/RatingStars.astro';
import { fetchDirectoryItems, type DirectoryItem } from '../../lib/api';
import '../../styles/base.css';

export const prerender = true;

export async function getStaticPaths() {
  const items = await fetchDirectoryItems();
  return items.map(item => ({
    params: { slug: item.slug }
  }));
}

const { slug } = Astro.params;

// Fetch all directory items and find the one we want
const allItems = await fetchDirectoryItems();
const item = allItems.find(i => i.slug === slug);

if (!item) {
  return new Response('Directory item not found', { status: 404 });
}

// Get related items in the same category (excluding current item)
const relatedItems = allItems
  .filter(i => i.category === item.category && i.slug !== slug)
  .slice(0, 3);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{item.title} | Stories From The Web</title>
    <meta name="description" content={item.description} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://storiesfromtheweb.org/directories/${slug}`} />
    <meta property="og:title" content={`${item.title} | Stories From The Web`} />
    <meta property="og:description" content={item.description} />
    <meta property="og:image" content={item.coverImage} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={`https://storiesfromtheweb.org/directories/${slug}`} />
    <meta property="twitter:title" content={`${item.title} | Stories From The Web`} />
    <meta property="twitter:description" content={item.description} />
    <meta property="twitter:image" content={item.coverImage} />
    
    <!-- Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Product",
        "name": "${item.title}",
        "description": "${item.description}",
        "image": "${item.coverImage}",
        "url": "https://storiesfromtheweb.org/directories/${slug}",
        "category": "${item.category}",
        "priceRange": "${item.priceRange}"
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-neutral">
    <NavHeader />
    
    <main class="flex-grow">
      <!-- Directory Item Header -->
      <div class="relative">
        <div class="absolute inset-0 bg-gradient-to-b from-black/70 to-transparent z-10"></div>
        <img 
          src={item.coverImage} 
          alt={`Cover image for ${item.title}`} 
          class="w-full h-64 md:h-96 object-cover"
        />
        <div class="container mx-auto px-4 relative z-20 -mt-32 md:-mt-40 pb-6">
          <div class="bg-white rounded-lg shadow-lg p-6 md:p-8">
            <div class="flex flex-col md:flex-row md:items-center justify-between mb-4">
              <div>
                <div class="mb-2">
                  <span class="inline-block px-3 py-1 bg-accent/10 text-accent rounded-full text-sm font-medium">
                    {item.category}
                  </span>
                </div>
                <h1 class="text-3xl md:text-4xl font-display font-bold text-gray-800 mb-2">
                  {item.title}
                </h1>
                <div class="flex items-center gap-4">
                  <RatingStars rating={item.rating} />
                  <span class="text-lg font-semibold text-primary">{item.priceRange}</span>
                </div>
              </div>
            </div>
            
            <!-- Item Description -->
            <div class="prose prose-lg max-w-none mb-8">
              <p>{item.description}</p>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Related Items -->
      <section class="py-12 bg-gray-50">
        <div class="container mx-auto px-4">
          <h2 class="text-2xl font-display font-bold text-gray-800 mb-8">Similar Items in {item.category}</h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {relatedItems.map(item => (
              <div class="bg-white rounded-lg overflow-hidden shadow-md">
                <img 
                  src={item.coverImage} 
                  alt={item.title}
                  class="w-full h-48 object-cover"
                />
                <div class="p-6">
                  <div class="mb-2">
                    <span class="inline-block px-2 py-1 bg-accent/10 text-accent rounded-full text-xs font-medium">
                      {item.category}
                    </span>
                  </div>
                  <h3 class="text-xl font-semibold mb-2">
                    <a href={`/directories/${item.slug}`} class="text-gray-800 hover:text-primary">
                      {item.title}
                    </a>
                  </h3>
                  <div class="flex items-center justify-between">
                    <RatingStars rating={item.rating} size="sm" />
                    <span class="text-primary font-semibold">{item.priceRange}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    </main>
    
    <Footer />
  </body>
</html>