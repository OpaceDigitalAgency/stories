---
import Layout from '../../layouts/Layout.astro';
import { getConfig } from '../../lib/config';
import { fetchDirectoryItem, type DirectoryItem } from '../../lib/api';
import ApiErrorMessage from '../../components/ApiErrorMessage.astro';

// Dynamic route for directory details

// Get site name from config
const siteName = getConfig('site.name', 'Stories From The Web');

// Get the slug from the URL
const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/404');
}

// Initialize data
let item: DirectoryItem | null = null;
let apiError = false;
let apiErrorDetails: Error | null = null;

try {
  // Fetch directory item by slug
  item = await fetchDirectoryItem(slug);
  
  if (!item) {
    apiError = true;
    apiErrorDetails = new Error('Directory item not found');
  }
} catch (err) {
  console.error('Error fetching directory item:', err);
  apiError = true;
  apiErrorDetails = err instanceof Error ? err : new Error('An unknown error occurred');
}

// Page metadata
const title = item ? `${item.title} | ${siteName}` : `Directory Item Not Found | ${siteName}`;
const description = item ? item.description : `We couldn't find the directory item you're looking for.`;
---

<Layout title={title} description={description}>
  <main class="flex-grow w-full pt-24 pb-16">
    <div class="container mx-auto px-4 max-w-4xl">
      {apiError ? (
        <section class="py-8">
          <div class="container mx-auto px-4">
            <ApiErrorMessage error={apiErrorDetails} message="We couldn't find this directory item. It may have been moved or deleted." />
          </div>
        </section>
      ) : item && (
        <>
          <header class="mb-8">
            <h1 class="text-4xl font-bold text-text-primary mb-4">{item.title}</h1>
            <p class="text-xl text-text-secondary">{item.category}</p>
          </header>

          <div class="prose prose-lg max-w-none">
            <div class="mb-6">
              <h2 class="text-2xl font-bold mb-2">Description</h2>
              <p>{item.description}</p>
            </div>

            <div class="mb-6">
              <h2 class="text-2xl font-bold mb-2">Price Range</h2>
              <p>{item.priceRange}</p>
            </div>

            <div class="mb-6">
              <h2 class="text-2xl font-bold mb-2">Rating</h2>
              <div class="flex items-center">
                <span class="text-yellow-500 mr-2">★</span>
                <span>{item.rating} / 5</span>
              </div>
            </div>
          </div>
        </>
      )}
    </div>
  </main>
</Layout>