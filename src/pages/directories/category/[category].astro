---
import Layout from '../../../layouts/Layout.astro';
import { fetchDirectoryItems, type DirectoryItem } from '../../../lib/api';
import { getConfig } from '../../../lib/config';
import ApiErrorMessage from '../../../components/ApiErrorMessage.astro';
import PageHero from '../../../components/PageHero.astro';

// Get the category from the URL
const { category } = Astro.params;

// Decode and format the category name
const decodedCategory = decodeURIComponent(category || '').split('-')
  .map(word => word.charAt(0).toUpperCase() + word.slice(1))
  .join(' ');

// Get site name from config
const siteName = getConfig('site.name', 'Stories From The Web');

// Page metadata
const title = `${decodedCategory} Resources | ${siteName}`;
const description = `Browse our curated collection of ${decodedCategory.toLowerCase()} resources for young readers and educators.`;

// Initialize data
let items: DirectoryItem[] = [];
let categories: string[] = ['Books & Reading', 'Educational Tools', 'Creative Resources'];
let apiError = false;
let apiErrorDetails: Error | null = null;

try {
  // Fetch all directory items
  const allItems = await fetchDirectoryItems();
  
  // Filter items by category
  items = allItems.filter(item => 
    item.category?.toLowerCase() === decodedCategory.toLowerCase()
  );

  // Extract unique categories from all items
  if (allItems.length > 0) {
    const uniqueCategories = new Set<string>();
    allItems.forEach(item => {
      if (item.category) {
        uniqueCategories.add(item.category);
      }
    });
    if (uniqueCategories.size > 0) {
      categories = Array.from(uniqueCategories);
    }
  }
} catch (err) {
  console.error('Error fetching directory items:', err);
  apiError = true;
  apiErrorDetails = err instanceof Error ? err : new Error('An unknown error occurred');
  items = [];
}
---

<Layout title={title} description={description}>
  <main class="flex-grow w-full">
    <PageHero
      title={`${decodedCategory} Resources`}
      description={`Browse our curated collection of ${decodedCategory.toLowerCase()} resources for young readers and educators.`}
      type="directories"
      showSearch={true}
    />

    {apiError && (
      <section class="py-8 bg-white/50 backdrop-blur-sm border-b">
        <div class="container mx-auto px-4">
          <ApiErrorMessage error={apiErrorDetails} message="We're having trouble loading directory data right now. Please try again later." />
        </div>
      </section>
    )}

    <!-- Categories Section -->
    <section class="py-8 bg-white/50 backdrop-blur-sm border-b">
      <div class="container mx-auto px-4">
        <div class="flex flex-wrap gap-2 justify-center">
          <a href="/directories" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 rounded-full text-sm font-medium transition-colors">
            All Resources
          </a>
          {categories.map(cat => (
            <a 
              href={`/directories/category/${cat.toLowerCase().replace(/\s+/g, '-')}`} 
              class={`px-4 py-2 rounded-full text-sm font-medium transition-colors ${
                cat.toLowerCase() === decodedCategory.toLowerCase() 
                  ? 'bg-accent text-white' 
                  : 'bg-gray-100 hover:bg-gray-200 text-gray-800'
              }`}
            >
              {cat}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Directory Items Grid -->
    <section class="py-12">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {items.length > 0 ? (
            items.map(item => (
              <div class="bg-white/50 backdrop-blur-sm rounded-xl shadow-md overflow-hidden hover:shadow-lg transition-shadow">
                <a href={`/directories/${item.slug}`} class="block">
                  <div class="h-48 bg-gray-200">
                    <img
                      src={item.logo || '/images/default-cover.svg'}
                      alt={item.name}
                      class="w-full h-full object-cover"
                    />
                  </div>

                  <div class="p-6">
                    <div class="flex items-center mb-3">
                      <span class="bg-accent/10 text-accent px-2 py-1 rounded-full text-xs font-medium">
                        {item.category || 'General'}
                      </span>
                      {item.priceRange && (
                        <span class="text-gray-500 text-xs ml-3">
                          Price: {item.priceRange}
                        </span>
                      )}
                    </div>

                    <h3 class="text-xl font-display font-bold text-text-primary mb-3 hover:text-accent transition-colors">
                      {item.name}
                    </h3>

                    <p class="text-text-secondary text-sm mb-4 line-clamp-3">
                      {item.description || 'No description available.'}
                    </p>

                    <div class="flex items-center justify-between">
                      <div class="flex items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-yellow-500 mr-1">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
                        </svg>
                        <span class="text-sm font-medium">{item.rating || 0}/5</span>
                      </div>

                      <span class="text-accent hover:text-accent/80 text-sm font-medium flex items-center">
                        Learn More
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3 ml-1">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                        </svg>
                      </span>
                    </div>
                  </div>
                </a>
              </div>
            ))
          ) : (
            <div class="col-span-1 md:col-span-2 lg:col-span-3 text-center py-12">
              <p class="text-lg text-gray-600">No resources available in this category at the moment. Please check back later.</p>
            </div>
          )}
        </div>
      </div>
    </section>
  </main>
</Layout>