---
import Layout from '../../layouts/Layout.astro';
import { fetchDirectoryItems, type DirectoryItem } from '../../lib/api';
import { getConfig } from '../../lib/config';
import ApiErrorMessage from '../../components/ApiErrorMessage.astro';

// Get site name from config
const siteName = getConfig('site.name', 'Stories From The Web');

// Page metadata
const title = `Directories | ${siteName}`;
const description = "Browse our curated collection of educational resources, including books, learning materials, and teaching tools.";

// Initialize data
let items: DirectoryItem[] = [];
let apiError = false;
let apiErrorDetails: Error | null = null;

// Define categories
const categories = [
  {
    title: 'Books & Reading',
    description: 'Curated collections of children\'s books, reading lists, and literacy resources.',
    color: 'primary',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />'
  },
  {
    title: 'Educational Tools',
    description: 'Learning tools, worksheets, and educational resources for teachers and parents.',
    color: 'secondary',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5" />'
  },
  {
    title: 'Creative Resources',
    description: 'Art supplies, craft ideas, and creative resources for young storytellers.',
    color: 'accent',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42" />'
  }
];

try {
  // Fetch directory items
  items = await fetchDirectoryItems();
} catch (err) {
  console.error('Error fetching directory items:', err);
  apiError = true;
  apiErrorDetails = err instanceof Error ? err : new Error('An unknown error occurred');
  items = [];
}

---

<Layout title={title} description={description}>
  <main class="flex-grow w-full">
    <!-- Hero Section -->
      <section class="bg-gradient-to-r from-primary/90 to-accent/90 text-white py-16">
        <div class="container mx-auto px-4">
          <h1 class="text-3xl md:text-4xl font-display font-bold mb-4">
            Educational Resources Directory
          </h1>
          <p class="text-lg md:text-xl max-w-3xl mb-6">
            Browse our curated collection of educational resources, including books, learning materials, and teaching tools.
          </p>

          <!-- Search Bar -->
          <div class="max-w-2xl">
            <div class="relative">
              <input
                type="text"
                placeholder="Search resources..."
                class="w-full px-4 py-3 pl-12 rounded-md border-none focus:outline-none focus:ring-2 focus:ring-white/50 text-gray-800"
              />
              <div class="absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-500">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                </svg>
              </div>
            </div>
          </div>
        </div>
      </section>

      {apiError && (
        <section class="py-8 bg-white border-b">
          <div class="container mx-auto px-4">
            <ApiErrorMessage error={apiErrorDetails} message="We're having trouble loading directory data right now. Please try again later." />
          </div>
        </section>
      )}

      <!-- Directory Categories -->
      <section class="py-12">
        <div class="container mx-auto px-4">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {categories.map(category => (
              <div class={`bg-white rounded-xl shadow-md p-6 hover:shadow-lg transition-shadow group ${
                category.color === "primary" ? "hover:bg-primary/5" :
                category.color === "secondary" ? "hover:bg-secondary/5" :
                "hover:bg-accent/5"
              }`}>
                <div class={`w-12 h-12 rounded-full flex items-center justify-center mb-4 ${
                  category.color === "primary" ? "bg-primary/10 text-primary" :
                  category.color === "secondary" ? "bg-secondary/10 text-secondary" :
                  "bg-accent/10 text-accent"
                }`}>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                    <Fragment set:html={category.icon} />
                  </svg>
                </div>

                <h2 class="text-xl font-display font-bold mb-2">{category.title}</h2>
                <p class="text-gray-600">{category.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Directory Items -->
      <section class="py-12 bg-gray-50">
        <div class="container mx-auto px-4">
          <h2 class="text-2xl font-display font-bold text-gray-800 mb-8">Featured Resources</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {items.length > 0 ? (
              items.map(item => (
                <div class="bg-white rounded-lg shadow-md overflow-hidden">
                  <img
                    src={item.logo || '/images/default-cover.svg'}
                    alt={item.name}
                    class="w-full h-48 object-cover"
                  />
                  <div class="p-6">
                    <h3 class="text-xl font-bold mb-2">{item.name}</h3>
                    <p class="text-gray-600 mb-4">{item.description || 'No description available.'}</p>
                    <div class="flex items-center justify-between">
                      <span class="text-sm text-gray-500">{item.category || 'General'}</span>
                      <span class="text-sm text-gray-500">Price Range: {item.priceRange || 'N/A'}</span>
                    </div>
                    <div class="mt-4 flex items-center">
                      <span class="text-sm text-gray-500 mr-2">Rating:</span>
                      <span class="text-sm font-medium">{item.rating || 0}/5</span>
                    </div>
                    <a
                      href={`/directories/${item.slug}`}
                      class="mt-4 block w-full text-center py-2 bg-primary text-white rounded-md hover:bg-primary/90 transition-colors"
                    >
                      Learn More
                    </a>
                  </div>
                </div>
              ))
            ) : (
              <div class="col-span-1 md:col-span-2 lg:col-span-3 text-center py-12">
                <p class="text-lg text-gray-600">No directory items available at the moment. Please check back later.</p>
              </div>
            )}
          </div>
        </div>
      </section>

      <!-- Newsletter Section -->
      <section class="py-16 bg-secondary/10">
        <div class="container mx-auto px-4 max-w-4xl text-center">
          <h2 class="text-3xl font-display font-bold text-text-primary mb-4">Stay Updated</h2>
          <p class="text-text-secondary text-lg mb-8">
            Subscribe to our newsletter to receive updates about new educational resources and teaching materials.
          </p>

          <form class="max-w-2xl mx-auto">
            <div class="flex flex-col sm:flex-row gap-3">
              <input
                type="email"
                placeholder="Your email address"
                class="flex-grow px-4 py-3 rounded-xl border-2 border-neutral-dark focus:outline-none focus:ring-2 focus:ring-secondary focus:border-transparent transition-all duration-300"
                required
              />
              <button
                type="submit"
                class="btn btn-secondary px-6 py-3 shadow-playful btn-playful whitespace-nowrap"
              >
                <span class="flex items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 mr-2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
                  </svg>
                  Subscribe
                </span>
              </button>
            </div>
            <p class="text-sm text-gray-500 mt-3">
              We respect your privacy. Unsubscribe at any time.
            </p>
          </form>
        </div>
      </section>
  </main>
</Layout>