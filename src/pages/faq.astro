---
import Layout from '../layouts/Layout.astro';
import { getConfig } from '../lib/config';

// Get site name from config
const siteName = getConfig('site.name', 'Stories From The Web');

// Page metadata
const title = `Frequently Asked Questions | ${siteName}`;
const description = `Find answers to common questions about ${siteName}, including how to publish stories, account management, and using our platform.`;

// FAQ interfaces
interface FaqItem {
  question: string;
  answer: string;
}

interface FaqCategory {
  name: string;
  questions: FaqItem[];
}

// FAQ categories data
const faqCategories: FaqCategory[] = [
  {
    name: "Getting Started",
    questions: [
      {
        question: "What is Stories From The Web?",
        answer: "Stories From The Web is a platform where children can share their creative writing and stories with others. We provide a safe, moderated environment for young writers to publish their work and connect with other storytellers."
      },
      {
        question: "How do I create an account?",
        answer: "To create an account, click the 'Sign Up' button in the top right corner. You'll need to provide a username, email address (parent's email for children under 13), and choose a password. Parents must approve accounts for children under 13."
      },
      {
        question: "Is Stories From The Web free to use?",
        answer: "Yes, Stories From The Web is free to use! We offer basic features to all users, with optional premium features available through our subscription plans."
      }
    ]
  },
  {
    name: "Publishing Stories",
    questions: [
      {
        question: "How do I publish a story?",
        answer: "To publish a story, log into your account and click the 'Create Story' button. You can write directly in our editor or paste your story from another document. Add a title, cover image, and tags, then submit for moderation."
      },
      {
        question: "What types of stories can I publish?",
        answer: "You can publish any original story suitable for children. This includes fiction, non-fiction, poetry, and personal experiences. All content must follow our community guidelines and be appropriate for young readers."
      },
      {
        question: "How long does moderation take?",
        answer: "Most stories are reviewed within 24-48 hours. We check all content to ensure it's appropriate for our young audience and follows our community guidelines."
      }
    ]
  },
  {
    name: "Account Management",
    questions: [
      {
        question: "How do I reset my password?",
        answer: "Click 'Forgot Password' on the login page and enter your email address. We'll send you instructions to reset your password. For child accounts, the reset link will be sent to the parent's email."
      },
      {
        question: "Can I change my username?",
        answer: "Yes, you can change your username once every 30 days. Go to your account settings and select 'Edit Profile' to make this change."
      },
      {
        question: "How do I delete my account?",
        answer: "To delete your account, go to your account settings and select 'Delete Account'. For child accounts, a parent must approve the deletion request."
      }
    ]
  },
  {
    name: "Safety & Privacy",
    questions: [
      {
        question: "How do you protect children's privacy?",
        answer: "We follow strict privacy guidelines and never share personal information. Child accounts have additional safety features and require parental consent. All interactions are monitored and moderated."
      },
      {
        question: "Can I make my stories private?",
        answer: "Yes, when publishing a story you can choose to make it private (visible only to you) or public (visible to all users). You can change this setting at any time."
      },
      {
        question: "How do I report inappropriate content?",
        answer: "Click the 'Report' button on any story, comment, or user profile to alert our moderation team. We review all reports within 24 hours and take appropriate action."
      }
    ]
  }
];
---

<Layout title={title} description={description}>
  <main class="flex-grow w-full">
    <div class="container mx-auto px-4 py-8 max-w-5xl">
        <header class="mb-8 text-center">
          <h1 class="text-4xl font-bold text-text-primary mb-4">
            Frequently Asked Questions
          </h1>
          <p class="text-xl text-text-secondary">
            Find answers to common questions about Stories From The Web
          </p>
        </header>

        <!-- Search Bar -->
        <div class="max-w-2xl mx-auto mb-10">
          <div class="relative">
            <input 
              type="text" 
              id="faq-search" 
              placeholder="Search for questions..." 
              class="w-full px-4 py-3 pl-12 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary"
            />
            <div class="absolute left-4 top-3.5 text-gray-400">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
          </div>
        </div>

        <div class="flex flex-col md:flex-row gap-8">
          <!-- Category Navigation -->
          <div class="md:w-1/4">
            <div class="bg-white rounded-xl shadow-md p-4 sticky top-4">
              <h2 class="text-lg font-bold mb-4 px-2">Categories</h2>
              <nav class="space-y-1">
                {faqCategories.map((category, index) => (
                  <button 
                    class={`faq-nav-item w-full text-left px-4 py-2 rounded-lg border border-transparent hover:bg-purple-50 hover:text-purple-700 ${index === 0 ? 'active' : ''}`}
                    data-category={category.name}
                  >
                    {category.name}
                  </button>
                ))}
                <button 
                  class="faq-nav-item w-full text-left px-4 py-2 rounded-lg border border-transparent hover:bg-purple-50 hover:text-purple-700"
                  data-category="all"
                >
                  View All
                </button>
              </nav>
            </div>
          </div>
          
          <!-- FAQ Content -->
          <div class="md:w-3/4">
            <div id="faq-container">
              {faqCategories.map((category) => (
                <div class="faq-category mb-8" data-category={category.name}>
                  <h2 class="text-2xl font-bold mb-6">{category.name}</h2>
                  <div class="space-y-4">
                    {category.questions.map((item) => (
                      <details class="bg-white rounded-xl shadow-md overflow-hidden group">
                        <summary class="flex justify-between items-center p-6 cursor-pointer">
                          <h3 class="text-lg font-semibold pr-8">{item.question}</h3>
                          <span class="text-primary group-open:rotate-180 transition-transform">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                          </span>
                        </summary>
                        <div class="px-6 pb-6 text-gray-600">
                          <p>{item.answer}</p>
                        </div>
                      </details>
                    ))}
                  </div>
                </div>
              ))}
            </div>
            
            <!-- No Results Message -->
            <div id="no-results" class="hidden text-center py-12">
              <p class="text-lg text-gray-500">No matching questions found. Please try a different search term.</p>
            </div>
          </div>
        </div>

        <!-- Still Have Questions -->
        <div class="bg-gradient-to-r from-primary/10 to-secondary/10 rounded-xl p-8 mt-12 text-center">
          <h2 class="text-2xl font-bold mb-4">Still Have Questions?</h2>
          <p class="text-lg mb-6">
            Can't find the answer you're looking for? Please contact our support team.
          </p>
          <a href="/contact" class="inline-block bg-primary text-white px-6 py-3 rounded-lg font-semibold hover:bg-primary-dark transition-colors">
            Contact Us
          </a>
        </div>
      </div>
  </main>
  <script slot="scripts">
    
      // Category navigation
      const categoryButtons = document.querySelectorAll('.faq-nav-item');
      const faqCategories = document.querySelectorAll('.faq-category');
      const noResults = document.getElementById('no-results');
      
      // Set initial state - show first category
      showCategory(faqCategories[0].dataset.category);
      
      // Add click event to category buttons
      categoryButtons.forEach(button => {
        button.addEventListener('click', () => {
          // Remove active class from all buttons
          categoryButtons.forEach(btn => btn.classList.remove('active'));
          
          // Add active class to clicked button
          button.classList.add('active');
          
          // Show selected category
          const category = button.dataset.category;
          showCategory(category);
          
          // Clear search
          document.getElementById('faq-search').value = '';
        });
      });
      
      // Function to show selected category
      function showCategory(category) {
        if (category === 'all') {
          // Show all categories
          faqCategories.forEach(cat => cat.style.display = 'block');
        } else {
          // Show only selected category
          faqCategories.forEach(cat => {
            if (cat.dataset.category === category) {
              cat.style.display = 'block';
            } else {
              cat.style.display = 'none';
            }
          });
        }
        
        // Hide no results message
        noResults.style.display = 'none';
      }
      
      // Search functionality
      const searchInput = document.getElementById('faq-search');
      const allQuestions = document.querySelectorAll('details');
      
      searchInput.addEventListener('input', () => {
        const searchTerm = searchInput.value.toLowerCase().trim();
        
        if (searchTerm === '') {
          // If search is empty, revert to category view
          const activeCategory = document.querySelector('.faq-nav-item.active').dataset.category;
          showCategory(activeCategory);
          return;
        }
        
        // Show all categories for searching
        faqCategories.forEach(cat => cat.style.display = 'block');
        
        // Reset active state on category buttons
        categoryButtons.forEach(btn => btn.classList.remove('active'));
        document.querySelector('[data-category="all"]').classList.add('active');
        
        let matchFound = false;
        
        // Search through all questions
        allQuestions.forEach(question => {
          const questionText = question.querySelector('h3').textContent.toLowerCase();
          const answerText = question.querySelector('p').textContent.toLowerCase();
          
          if (questionText.includes(searchTerm) || answerText.includes(searchTerm)) {
            question.style.display = 'block';
            matchFound = true;
            
            // Expand matching questions
            question.open = true;
          } else {
            question.style.display = 'none';
          }
        });
        
        // Show/hide no results message
        noResults.style.display = matchFound ? 'none' : 'block';
        
        // Hide category headers if no questions in that category match
        faqCategories.forEach(category => {
          const visibleQuestions = category.querySelectorAll('details[style="display: block;"]');
          if (visibleQuestions.length === 0) {
            category.style.display = 'none';
          }
        });
      });
    
  </script>
</Layout>