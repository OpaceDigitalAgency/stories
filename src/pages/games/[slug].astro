---
import NavHeader from '../../components/NavHeader.astro';
import Footer from '../../components/Footer.astro';
import RatingStars from '../../components/RatingStars.astro';
import { fetchGames, type Game } from '../../lib/api';
import '../../styles/base.css';

export const prerender = true;

export async function getStaticPaths() {
  const games = await fetchGames();
  return games.map(game => ({
    params: { slug: game.slug }
  }));
}

const { slug } = Astro.params;

// Fetch all games and find the one we want
const allGames = await fetchGames();
const game = allGames.find(g => g.slug === slug);

if (!game) {
  return new Response('Game not found', { status: 404 });
}

// Get related games (excluding current game)
const relatedGames = allGames
  .filter(g => g.slug !== slug)
  .slice(0, 3);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{game.title} | Stories From The Web</title>
    <meta name="description" content={game.description} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://storiesfromtheweb.org/games/${slug}`} />
    <meta property="og:title" content={`${game.title} | Stories From The Web`} />
    <meta property="og:description" content={game.description} />
    <meta property="og:image" content={game.coverImage} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={`https://storiesfromtheweb.org/games/${slug}`} />
    <meta property="twitter:title" content={`${game.title} | Stories From The Web`} />
    <meta property="twitter:description" content={game.description} />
    <meta property="twitter:image" content={game.coverImage} />
    
    <!-- Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Game",
        "name": "${game.title}",
        "description": "${game.description}",
        "image": "${game.coverImage}",
        "url": "https://storiesfromtheweb.org/games/${slug}"
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-neutral">
    <NavHeader />
    
    <main class="flex-grow">
      <!-- Game Header -->
      <div class="relative">
        <div class="absolute inset-0 bg-gradient-to-b from-black/70 to-transparent z-10"></div>
        <img 
          src={game.coverImage} 
          alt={`Cover image for ${game.title}`} 
          class="w-full h-64 md:h-96 object-cover"
        />
        <div class="container mx-auto px-4 relative z-20 -mt-32 md:-mt-40 pb-6">
          <div class="bg-white rounded-lg shadow-lg p-6 md:p-8">
            <div class="flex flex-col md:flex-row md:items-center justify-between mb-4">
              <div>
                <h1 class="text-3xl md:text-4xl font-display font-bold text-gray-800 mb-2">
                  {game.title}
                </h1>
                <div class="flex items-center gap-4">
                  <RatingStars rating={game.rating} />
                  <span class="text-lg font-semibold text-primary">${game.price}</span>
                </div>
              </div>
            </div>
            
            <!-- Game Description -->
            <div class="prose prose-lg max-w-none mb-8">
              <p>{game.description}</p>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Related Games -->
      <section class="py-12 bg-gray-50">
        <div class="container mx-auto px-4">
          <h2 class="text-2xl font-display font-bold text-gray-800 mb-8">Similar Games</h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {relatedGames.map(game => (
              <div class="bg-white rounded-lg overflow-hidden shadow-md">
                <img 
                  src={game.coverImage} 
                  alt={game.title}
                  class="w-full h-48 object-cover"
                />
                <div class="p-6">
                  <h3 class="text-xl font-semibold mb-2">
                    <a href={`/games/${game.slug}`} class="text-gray-800 hover:text-primary">
                      {game.title}
                    </a>
                  </h3>
                  <div class="flex items-center justify-between">
                    <RatingStars rating={game.rating} size="sm" />
                    <span class="text-primary font-semibold">${game.price}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    </main>
    
    <Footer />
  </body>
</html>