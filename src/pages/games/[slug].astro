---
import Layout from '../../layouts/Layout.astro';
import { getConfig } from '../../lib/config';
import { fetchGame, type Game } from '../../lib/api';
import ApiErrorMessage from '../../components/ApiErrorMessage.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHero from '../../components/PageHero.astro';

export const prerender = false;

// Get site name from config
const siteName = getConfig('site.name', 'Stories From The Web');

// Get the slug from the URL
const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/404');
}

// Initialize data
let item: Game | null = null;
let apiError = false;
let apiErrorDetails: Error | null = null;

try {
  // Fetch game by slug
  item = await fetchGame(slug);
  
  if (!item) {
    return Astro.redirect('/404');
  }
} catch (err) {
  console.error('Error fetching game:', err);
  apiError = true;
  apiErrorDetails = err instanceof Error ? err : new Error('An unknown error occurred');
  item = null;
}

// Page metadata
const title = item ? `${item.title} | ${siteName}` : `Game Not Found | ${siteName}`;
const description = item ? item.description : `We couldn't find the game you're looking for.`;
---

<Layout title={title} description={description}>
  <main class="flex-grow w-full">
    <PageHero
      title={item?.title || 'Game'}
      description={item?.description}
      type="games"
    />

    <div class="container relative z-10">
      <div class="max-w-4xl mx-auto">
        <Breadcrumbs
          crumbs={[
            { text: 'Games', href: '/games' },
            { text: item?.title || '' }
          ]}
        />
      {apiError ? (
        <section class="py-8">
          <div class="container mx-auto px-4">
            <ApiErrorMessage error={apiErrorDetails} message="We're having trouble loading this game. Please try again later." />
          </div>
        </section>
      ) : !item ? (
        <section class="py-8">
          <div class="container mx-auto px-4">
            <div class="text-center">
              <h1 class="text-2xl font-bold text-text-primary mb-4">Game Not Found</h1>
              <p class="text-text-secondary">The game you're looking for could not be found.</p>
            </div>
          </div>
        </section>
      ) : (
        <>
          <header class="mb-12">
            <div class="flex flex-col md:flex-row gap-8 items-start">
              <!-- Game Cover -->
              <div class="w-64 h-64 rounded-2xl overflow-hidden shadow-xl transform-style-3d hover:translate-z-8 transition-transform duration-500">
                <img
                  src={typeof item.coverImage === 'string' ? item.coverImage :
                       typeof item.coverImage === 'object' ? item.coverImage.default :
                       '/images/default-cover.svg'}
                  alt={item.title}
                  class="w-full h-full object-cover"
                />
              </div>

              <div class="flex-1">
                <!-- Category Badge -->
                <div class="mb-4">
                  <span class="bg-primary/10 text-primary px-3 py-1 rounded-full text-sm font-medium">
                    {item.category || 'General'}
                  </span>
                  {item.featured && (
                    <span class="ml-2 bg-yellow-100 text-yellow-800 px-3 py-1 rounded-full text-sm font-medium">
                      Featured Game
                    </span>
                  )}
                </div>

                <!-- Title and Description -->
                <h1 class="text-4xl font-display font-bold mb-4 text-text-primary fancy-underline transform-style-3d hover:translate-z-8 transition-transform duration-500">
                  {item.title}
                </h1>
                <p class="text-lg text-text-secondary mb-6">{item.description}</p>

                <!-- Action Buttons -->
                <div class="flex flex-wrap gap-4">
                  {item.website_url && (
                    <a
                      href={item.website_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center bg-primary text-white px-6 py-3 rounded-xl hover:bg-primary-600 transition-colors transform-style-3d hover:translate-z-4 hover:scale-105"
                    >
                      Play Now
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 ml-2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                      </svg>
                    </a>
                  )}
                  {item.rating > 0 && (
                    <span class="inline-flex items-center bg-green-100 text-green-800 px-4 py-3 rounded-xl text-sm font-medium">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5 mr-1">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                      </svg>
                      {item.rating} / 5
                    </span>
                  )}
                </div>
              </div>
            </div>
          </header>

          <!-- Game Details -->
          <div class="bg-white rounded-xl shadow-md p-8 mb-12">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              <div>
                <h3 class="text-xl font-bold mb-4">Game Info</h3>
                <div class="bg-gray-50 rounded-lg p-4 space-y-3">
                  <p class="flex items-center text-text-secondary">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-2 text-primary">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.171-.879-1.172-2.303 0-3.182C10.536 7.719 11.768 7.5 12 7.5c.725 0 1.45.22 2.003.659" />
                    </svg>
                    <strong class="mr-2">Price:</strong> ${item.price.toFixed(2)}
                  </p>
                  <p class="flex items-center text-text-secondary">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-2 text-primary">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <strong class="mr-2">Age Range:</strong> {item.ageRange}
                  </p>
                  {item.developer && (
                    <p class="flex items-center text-text-secondary">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-2 text-primary">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />
                      </svg>
                      <strong class="mr-2">Developer:</strong> {item.developer}
                    </p>
                  )}
                  {item.publisher && (
                    <p class="flex items-center text-text-secondary">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-2 text-primary">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
                      </svg>
                      <strong class="mr-2">Publisher:</strong> {item.publisher}
                    </p>
                  )}
                  {item.release_date && (
                    <p class="flex items-center text-text-secondary">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-2 text-primary">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5m-9-6h.008v.008H12v-.008zM12 15h.008v.008H12V15zm0 2.25h.008v.008H12v-.008zM9.75 15h.008v.008H9.75V15zm0 2.25h.008v.008H9.75v-.008zM7.5 15h.008v.008H7.5V15zm0 2.25h.008v.008H7.5v-.008zm6.75-4.5h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V15zm0 2.25h.008v.008h-.008v-.008zm2.25-4.5h.008v.008H16.5v-.008zm0 2.25h.008v.008H16.5V15z" />
                      </svg>
                      <strong class="mr-2">Release Date:</strong> {new Date(item.release_date).toLocaleDateString()}
                    </p>
                  )}
                </div>
              </div>

              {item.platform && (
                <div>
                  <h3 class="text-xl font-bold mb-4">Platform Requirements</h3>
                  <div class="bg-gray-50 rounded-lg p-4">
                    <p class="text-text-secondary whitespace-pre-line">{item.platform}</p>
                  </div>
                </div>
              )}
            </div>
          </div>

          <!-- Share Section -->
          <div class="flex flex-wrap items-center justify-center gap-4 mb-12 p-6 bg-white rounded-xl shadow-md">
            <span class="text-text-secondary font-bold">Share this game:</span>
            <a
              href={`https://twitter.com/intent/tweet?url=https://storiesfromtheweb.org/games/${slug}&text=${encodeURIComponent(item.title)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-blue-400 text-white p-3 rounded-full hover:bg-blue-500 transition-colors duration-300 transform-style-3d hover:translate-z-4 hover:scale-110"
              aria-label="Share on Twitter"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/>
              </svg>
            </a>
            <a
              href={`https://www.linkedin.com/shareArticle?mini=true&url=https://storiesfromtheweb.org/games/${slug}&title=${encodeURIComponent(item.title)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-blue-700 text-white p-3 rounded-full hover:bg-blue-800 transition-colors duration-300 transform-style-3d hover:translate-z-4 hover:scale-110"
              aria-label="Share on LinkedIn"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M4.98 3.5c0 1.381-1.11 2.5-2.48 2.5s-2.48-1.119-2.48-2.5c0-1.38 1.11-2.5 2.48-2.5s2.48 1.12 2.48 2.5zm.02 4.5h-5v16h5v-16zm7.982 0h-4.968v16h4.969v-8.399c0-4.67 6.029-5.052 6.029 0v8.399h4.988v-10.131c0-7.88-8.922-7.593-11.018-3.714v-2.155z"/>
              </svg>
            </a>
            <a
              href={`mailto:?subject=${encodeURIComponent(item.title)}&body=Check out this game: https://storiesfromtheweb.org/games/${slug}`}
              class="bg-gray-700 text-white p-3 rounded-full hover:bg-gray-800 transition-colors duration-300 transform-style-3d hover:translate-z-4 hover:scale-110"
              aria-label="Share via Email"
            >
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
            </a>
          </div>
        </>
      )}
    </div>

    <!-- Related Games -->
    <section class="py-16 bg-white">
      <div class="container">
        <h2 class="text-3xl font-display font-bold mb-12 text-text-primary fancy-underline transform-style-3d hover:translate-z-8 transition-transform duration-500">
          Similar Games
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 perspective-1000">
          {/* We'll add related games here in a future update */}
          <div class="text-center py-8 col-span-full">
            <p class="text-text-secondary">More games coming soon!</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Newsletter Signup -->
    <section class="py-16">
      <div class="container">
        <div class="max-w-4xl mx-auto bg-gradient-to-br from-primary-50 to-primary-100 rounded-3xl p-12 shadow-xl transform-style-3d hover:translate-z-8 transition-transform duration-500">
          <div class="text-center mb-8">
            <h2 class="text-3xl font-display font-bold mb-4 text-text-primary">Stay Updated</h2>
            <p class="text-lg text-text-secondary">
              Subscribe to our newsletter to receive updates about new games and features.
            </p>
          </div>

          <form class="max-w-xl mx-auto">
            <div class="flex flex-col sm:flex-row gap-4">
              <input
                type="email"
                placeholder="Your email address"
                class="flex-1 px-6 py-4 rounded-xl border border-neutral-200 shadow-playful focus:shadow-xl focus:border-primary-300 transition-all duration-300 outline-none"
                required
              />
              <button
                type="submit"
                class="bg-primary text-white font-bold py-4 px-8 rounded-xl shadow-playful hover:shadow-xl hover:bg-primary-600 transition-all duration-300 transform-style-3d hover:translate-z-4 hover:scale-105"
              >
                Subscribe
              </button>
            </div>
            <p class="text-xs text-text-secondary/70 text-center mt-4">
              By subscribing, you agree to our Privacy Policy and consent to receive updates from our company.
            </p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <style slot="scripts">
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(40px) scale(0.95);
      }
      50% {
        opacity: 0.5;
        transform: translateY(20px) scale(0.97);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .fancy-underline {
      position: relative;
      display: inline-block;
    }

    .fancy-underline::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: -5px;
      width: 100%;
      height: 3px;
      background: linear-gradient(90deg, var(--color-primary) 0%, var(--color-secondary) 50%, var(--color-accent) 100%);
      border-radius: 3px;
      transform: scaleX(0.7);
      transform-origin: center;
      transition: transform 0.5s ease;
    }

    .fancy-underline:hover::after {
      transform: scaleX(1);
    }

    .animate-blob {
      animation: blob 7s infinite;
    }

    .animation-delay-2000 {
      animation-delay: 2s;
    }

    .animation-delay-4000 {
      animation-delay: 4s;
    }

    @keyframes blob {
      0% {
        transform: translate(0px, 0px) scale(1);
      }
      33% {
        transform: translate(30px, -50px) scale(1.1);
      }
      66% {
        transform: translate(-20px, 20px) scale(0.9);
      }
      100% {
        transform: translate(0px, 0px) scale(1);
      }
    }
  </style>
</Layout>