---
import Layout from '../../layouts/Layout.astro';
import { fetchGames, type Game } from '../../lib/api';
import { getConfig } from '../../lib/config';
import ApiErrorMessage from '../../components/ApiErrorMessage.astro';
import PageHero from '../../components/PageHero.astro';

// Get site name from config
const siteName = getConfig('site.name', 'Stories From The Web');

// Page metadata
const title = `Games | ${siteName}`;
const description = "Explore fun and educational games for children of all ages. Develop skills while having fun!";

// Initialize data
// Initialize data
let games: Game[] = [];
let categories: string[] = ['Educational', 'Puzzle', 'Adventure', 'Reading', 'Math', 'Science'];
let apiError = false;
let apiErrorDetails: Error | null = null;

try {
  // Fetch games data
  const gamesData = await fetchGames();
  
  if (!gamesData) {
    throw new Error('No games data received');
  }

  games = gamesData;

  // Extract unique categories from games
  const uniqueCategories = new Set<string>();
  games.forEach(game => {
    if (game.category) {
      uniqueCategories.add(game.category);
    }
  });

  if (uniqueCategories.size > 0) {
    categories = Array.from(uniqueCategories);
  }
} catch (err) {
  console.error('Error fetching games data:', err);
  apiError = true;
  apiErrorDetails = err instanceof Error ? err : new Error('An unknown error occurred');
  games = [];
}

---

<Layout title={title} description={description}>
  <main class="flex-grow w-full">
    <PageHero
      title="Educational Games"
      description="Explore fun and educational games for children of all ages. Develop skills while having fun!"
      type="games"
      showSearch={true}
    />

      {apiError && (
        <section class="py-8 bg-white border-b">
          <div class="container mx-auto px-4">
            <ApiErrorMessage error={apiErrorDetails} message="We're having trouble loading games data right now. Please try again later." />
          </div>
        </section>
      )}

      <!-- Categories Section -->
      <section class="py-8 bg-white/50 backdrop-blur-sm border-b">
        <div class="container mx-auto px-4">
          <div class="flex flex-wrap gap-2 justify-center">
            <a href="/games" class="px-4 py-2 bg-tertiary text-white rounded-full text-sm font-medium">
              All Games
            </a>
            {categories.map(category => (
              <a href={`/games/category/${category.toLowerCase().replace(/\s+/g, '-')}`} class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 rounded-full text-sm font-medium transition-colors">
                {category}
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- Games Grid -->
      <section class="py-12">
        <div class="container mx-auto px-4">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {games.length > 0 ? (
              games.map(game => (
                <div class="bg-white/50 backdrop-blur-sm rounded-xl shadow-md overflow-hidden hover:shadow-lg transition-shadow">
                  <a href={`/games/${game.slug}`} class="block">
                    <div class="h-48 bg-gray-200">
                      <img
                        src={typeof game.coverImage === 'string' ? game.coverImage :
                             game.coverImage?.default || '/images/default-cover.svg'}
                        alt={game.title}
                        class="w-full h-full object-cover"
                      />
                    </div>

                    <div class="p-6">
                      <div class="flex items-center mb-3">
                        <span class="bg-tertiary/10 text-tertiary px-2 py-1 rounded-full text-xs font-medium">
                          {game.category || 'General'}
                        </span>
                        <span class="text-gray-500 text-xs ml-3">
                          Age: {game.ageRange || 'All Ages'}
                        </span>
                      </div>

                      <h3 class="text-xl font-display font-bold text-text-primary mb-3 hover:text-tertiary transition-colors">
                        {game.title}
                      </h3>

                      <p class="text-text-secondary text-sm mb-4 line-clamp-3">
                        {game.description || 'No description available.'}
                      </p>

                      <div class="flex items-center justify-between">
                        <div class="flex items-center">
                          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-yellow-500 mr-1">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
                          </svg>
                          <span class="text-sm font-medium">{game.rating || 0}/5</span>
                        </div>

                        <span class="text-tertiary hover:text-tertiary/80 text-sm font-medium flex items-center">
                          Play Now
                          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3 ml-1">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                          </svg>
                        </span>
                      </div>
                    </div>
                  </a>
                </div>
              ))
            ) : (
              <div class="col-span-1 md:col-span-2 lg:col-span-3 text-center py-12">
                <p class="text-lg text-gray-600">No games available at the moment. Please check back later.</p>
              </div>
            )}
          </div>
        </div>
      </section>

      <!-- Newsletter Section -->
      <section class="py-16">
        <div class="container mx-auto px-4">
          <div class="max-w-4xl mx-auto bg-gradient-to-br from-primary-50 to-primary-100 rounded-3xl p-12 shadow-xl transform-style-3d hover:translate-z-8 transition-transform duration-500 text-center">
          <h2 class="text-3xl font-display font-bold text-text-primary mb-4">Stay Updated</h2>
          <p class="text-text-secondary text-lg mb-8">
            Subscribe to our newsletter to receive updates about new games and educational resources.
          </p>

          <form class="max-w-2xl mx-auto">
            <div class="flex flex-col sm:flex-row gap-3">
              <input
                type="email"
                placeholder="Your email address"
                class="flex-grow px-4 py-3 rounded-xl border-2 border-neutral-dark focus:outline-none focus:ring-2 focus:ring-tertiary focus:border-transparent transition-all duration-300"
                required
              />
              <button
                type="submit"
                class="btn btn-tertiary px-6 py-3 shadow-playful btn-playful whitespace-nowrap"
              >
                <span class="flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 mr-2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
                  </svg>
                  Subscribe
                </span>
              </button>
            </div>
            <p class="text-sm text-gray-500 mt-3">
              We respect your privacy. Unsubscribe at any time.
            </p>
          </form>
          </div>
        </div>
      </section>
  </main>
</Layout>