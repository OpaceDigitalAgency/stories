---
import NavHeader from '../../components/NavHeader.astro';
import Footer from '../../components/Footer.astro';
import { fetchGames, type Game } from '../../lib/api';
import '../../styles/base.css';

export const prerender = true;

// Fetch games from API
const games = await fetchGames();

// Define categories
const categories = [
  "Educational",
  "Adventure",
  "Puzzle",
  "Word Games",
  "Math Games",
  "Science Games"
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Educational Games | Stories From The Web</title>
    <meta name="description" content="Explore fun and educational games for children of all ages. Develop skills while having fun!" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://storiesfromtheweb.org/games" />
    <meta property="og:title" content="Educational Games | Stories From The Web" />
    <meta property="og:description" content="Explore fun and educational games for children of all ages. Develop skills while having fun!" />
    <meta property="og:image" content="https://storiesfromtheweb.org/og-image-games.jpg" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://storiesfromtheweb.org/games" />
    <meta property="twitter:title" content="Educational Games | Stories From The Web" />
    <meta property="twitter:description" content="Explore fun and educational games for children of all ages. Develop skills while having fun!" />
    <meta property="twitter:image" content="https://storiesfromtheweb.org/twitter-image-games.jpg" />
  </head>
  <body class="min-h-screen flex flex-col bg-neutral w-full">
    <NavHeader />
    
    <main class="flex-grow w-full">
      <!-- Hero Section -->
      <section class="bg-gradient-to-r from-tertiary/90 to-accent/90 text-white py-16">
        <div class="container mx-auto px-4">
          <h1 class="text-3xl md:text-4xl font-display font-bold mb-4">
            Educational Games
          </h1>
          <p class="text-lg md:text-xl max-w-3xl mb-6">
            Explore fun and educational games for children of all ages. Develop skills while having fun!
          </p>
          
          <!-- Search Bar -->
          <div class="max-w-2xl">
            <div class="relative">
              <input 
                type="text" 
                placeholder="Search games..." 
                class="w-full px-4 py-3 pl-12 rounded-md border-none focus:outline-none focus:ring-2 focus:ring-white/50 text-gray-800"
              />
              <div class="absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-500">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                </svg>
              </div>
            </div>
          </div>
        </div>
      </section>
      
      <!-- Categories Section -->
      <section class="py-8 bg-white border-b">
        <div class="container mx-auto px-4">
          <div class="flex flex-wrap gap-2 justify-center">
            <a href="/games" class="px-4 py-2 bg-tertiary text-white rounded-full text-sm font-medium">
              All Games
            </a>
            {categories.map(category => (
              <a href={`/games/category/${category.toLowerCase().replace(/\s+/g, '-')}`} class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 rounded-full text-sm font-medium transition-colors">
                {category}
              </a>
            ))}
          </div>
        </div>
      </section>
      
      <!-- Games Grid -->
      <section class="py-12">
        <div class="container mx-auto px-4">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {games.map(game => (
              <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition-shadow">
                <a href={`/games/${game.slug}`} class="block">
                  <div class="h-48 bg-gray-200">
                    <img 
                      src={game.coverImage} 
                      alt={game.title} 
                      class="w-full h-full object-cover"
                    />
                  </div>
                  
                  <div class="p-6">
                    <div class="flex items-center mb-3">
                      <span class="bg-tertiary/10 text-tertiary px-2 py-1 rounded-full text-xs font-medium">
                        {game.category}
                      </span>
                      <span class="text-gray-500 text-xs ml-3">
                        Age: {game.ageRange}
                      </span>
                    </div>
                    
                    <h3 class="text-xl font-display font-bold text-text-primary mb-3 hover:text-tertiary transition-colors">
                      {game.title}
                    </h3>
                    
                    <p class="text-text-secondary text-sm mb-4 line-clamp-3">
                      {game.description}
                    </p>
                    
                    <div class="flex items-center justify-between">
                      <div class="flex items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-yellow-500 mr-1">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
                        </svg>
                        <span class="text-sm font-medium">{game.rating}/5</span>
                      </div>
                      
                      <span class="text-tertiary hover:text-tertiary/80 text-sm font-medium flex items-center">
                        Play Now
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3 ml-1">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                        </svg>
                      </span>
                    </div>
                  </div>
                </a>
              </div>
            ))}
          </div>
        </div>
      </section>
      
      <!-- Newsletter Section -->
      <section class="py-16 bg-gradient-to-r from-tertiary/10 to-accent/10">
        <div class="container mx-auto px-4 max-w-4xl text-center">
          <h2 class="text-3xl font-display font-bold text-text-primary mb-4">Stay Updated</h2>
          <p class="text-text-secondary text-lg mb-8">
            Subscribe to our newsletter to receive updates about new games and educational resources.
          </p>
          
          <form class="max-w-2xl mx-auto">
            <div class="flex flex-col sm:flex-row gap-3">
              <input
                type="email"
                placeholder="Your email address"
                class="flex-grow px-4 py-3 rounded-xl border-2 border-neutral-dark focus:outline-none focus:ring-2 focus:ring-tertiary focus:border-transparent transition-all duration-300"
                required
              />
              <button
                type="submit"
                class="btn btn-tertiary px-6 py-3 shadow-playful btn-playful whitespace-nowrap"
              >
                <span class="flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 mr-2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
                  </svg>
                  Subscribe
                </span>
              </button>
            </div>
            <p class="text-sm text-gray-500 mt-3">
              We respect your privacy. Unsubscribe at any time.
            </p>
          </form>
        </div>
      </section>
    </main>
    
    <Footer />
  </body>
</html>