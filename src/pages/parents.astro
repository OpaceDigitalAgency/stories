---
import Layout from '../layouts/Layout.astro';
import { getConfig } from '../lib/config';

// Get site name from config
const siteName = getConfig('site.name', 'Stories From The Web');

// Page metadata
const title = `For Parents | ${siteName}`;
const description = `Learn how ${siteName} provides a safe and engaging environment for your child to develop their creative writing skills.`;
---

<Layout title={title} description={description}>
  <main class="flex-grow w-full">
    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-primary/90 to-tertiary/90 text-white py-16">
      <div class="container mx-auto px-4">
        <h1 class="text-3xl md:text-4xl font-display font-bold mb-4">
          For Parents
        </h1>
        <p class="text-lg md:text-xl max-w-3xl mb-6">
          Support your child's creative writing journey in a safe and engaging online environment.
        </p>
      </div>
    </section>

    <!-- Benefits Section -->
    <section class="py-12 bg-white">
      <div class="container mx-auto px-4">
        <h2 class="text-2xl font-bold mb-8 text-center">Why Choose Stories From The Web?</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="bg-neutral-light p-6 rounded-xl">
            <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-primary">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-2">Safe Environment</h3>
            <p class="text-gray-600">Our platform is fully moderated and designed with child safety as the top priority.</p>
          </div>

          <div class="bg-neutral-light p-6 rounded-xl">
            <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-primary">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5" />
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-2">Educational Growth</h3>
            <p class="text-gray-600">Tools and features designed to develop writing skills, creativity, and confidence.</p>
          </div>

          <div class="bg-neutral-light p-6 rounded-xl">
            <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-primary">
                <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-2">Community</h3>
            <p class="text-gray-600">Connect with other young writers and share stories in a supportive environment.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="py-12 bg-neutral-dark">
      <div class="container mx-auto px-4">
        <h2 class="text-2xl font-bold mb-8 text-center">Parent Features</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="bg-white p-6 rounded-xl">
            <h3 class="text-xl font-bold mb-4">Safety & Monitoring</h3>
            <ul class="space-y-3">
              <li class="flex items-start">
                <svg class="w-6 h-6 text-primary mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Monitor your child's writing activity</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-primary mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Content moderation and safe browsing</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-primary mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Privacy controls and settings</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-primary mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Regular progress updates</span>
              </li>
            </ul>
          </div>

          <div class="bg-white p-6 rounded-xl">
            <h3 class="text-xl font-bold mb-4">Learning Support</h3>
            <ul class="space-y-3">
              <li class="flex items-start">
                <svg class="w-6 h-6 text-primary mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Writing guides and tutorials</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-primary mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Creative writing prompts</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-primary mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Progress tracking tools</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-primary mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Feedback and encouragement system</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-12 bg-white">
      <div class="container mx-auto px-4">
        <h2 class="text-2xl font-bold mb-8 text-center">Frequently Asked Questions</h2>
        
        <div class="max-w-3xl mx-auto space-y-6">
          <div class="bg-neutral-light p-6 rounded-xl">
            <h3 class="text-lg font-bold mb-2">Is Stories From The Web safe for children?</h3>
            <p class="text-gray-600">Yes, we prioritize safety with content moderation, secure accounts, and parental controls. All content is reviewed before publication.</p>
          </div>
          
          <div class="bg-neutral-light p-6 rounded-xl">
            <h3 class="text-lg font-bold mb-2">How can I monitor my child's activity?</h3>
            <p class="text-gray-600">Parents have access to a dashboard showing their child's writing activity, interactions, and progress. You can also set privacy preferences and content restrictions.</p>
          </div>
          
          <div class="bg-neutral-light p-6 rounded-xl">
            <h3 class="text-lg font-bold mb-2">What age is appropriate for Stories From The Web?</h3>
            <p class="text-gray-600">Our platform is designed for children aged 6-13, with age-appropriate content and features for different skill levels.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Get Started Section -->
    <section class="py-12 bg-gradient-to-r from-primary/10 to-tertiary/10">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-2xl font-bold mb-6">Start Your Child's Writing Journey</h2>
        <p class="text-lg text-gray-600 mb-8 max-w-2xl mx-auto">
          Join our community of young writers and help your child develop their creative writing skills in a safe, supportive environment.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/register" class="btn btn-primary px-8 py-3 shadow-playful btn-playful">
            Create Account
          </a>
          <a href="/contact" class="btn btn-secondary px-8 py-3 shadow-playful btn-playful">
            Learn More
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>