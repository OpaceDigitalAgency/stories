---
import Layout from '../../layouts/Layout.astro';
import ComingSoonPage from '../../components/ComingSoonPage.astro';
import { getConfig } from '../../lib/config';

// Get site name from config
const siteName = getConfig('site.name', 'Stories From The Web');

// Page metadata
const title = `Premium Stories | Coming Soon`;
const description = `Unlock exclusive content, personalized recommendations, and an enhanced reading experience with our premium subscription.`;

---

<Layout title={title} description={description}>
  <main class="flex-grow w-full">
    <ComingSoonPage
      title="Premium Stories"
      description="We're working on something special! Our premium subscription will give you access to exclusive content, personalized recommendations, and an enhanced reading experience."
      featureName="Premium Stories"
      estimatedRelease="Summer 2025"
      signupEnabled={true}
      image="https://api.storiesfromtheweb.org/uploads/optimized/68128956b67985-46295508-premium-reading-large.jpg"
      ctaText="Explore Free Stories"
      ctaLink="/stories"
      fullWidth={true}
    />
  </main>
</Layout>