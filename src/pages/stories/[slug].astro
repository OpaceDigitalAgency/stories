---
import NavHeader from '../../components/NavHeader.astro';
import Footer from '../../components/Footer.astro';
import RatingStars from '../../components/RatingStars.astro';
import TagBadge from '../../components/TagBadge.astro';
import ReviewSection from '../../components/ReviewSection.astro';
import SponsoredBadge from '../../components/SponsoredBadge.astro';
import ModerationCTA from '../../components/ModerationCTA.astro';
import CardStory from '../../components/CardStory.astro';
import { fetchStories } from '../../lib/api';
import '../../styles/base.css';

// Get the slug from the URL
const { slug } = Astro.params;

// Fetch story data
const stories = await fetchStories();
const story = stories.find(s => s.slug === slug);

// If story not found, redirect to 404
if (!story) {
  return Astro.redirect('/404');
}

// Get related stories (same author or tags)
const relatedStories = stories
  .filter(s => 
    s.slug !== slug && 
    (s.author?.slug === story.author?.slug || 
     s.tags?.some(tag => story.tags?.includes(tag)))
  )
  .slice(0, 4);

// Format date if available
const formattedDate = story.publishDate 
  ? new Date(story.publishDate).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric'
    })
  : null;

// Page metadata
const title = `${story.title} | Stories From The Web`;
const description = story.excerpt || `Read "${story.title}" on Stories From The Web`;
---

<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  
  <!-- Open Graph / Social Media Meta Tags -->
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={story.coverImage}>
  <meta property="og:url" content={`https://storiesfromtheweb.org/stories/${slug}`}>
  <meta property="og:type" content="article">
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={story.coverImage}>
</head>
<body class="min-h-screen bg-neutral-50 text-text-primary font-sans">
  <NavHeader />
  
  <main class="pt-24 pb-32">
    <!-- Story Header -->
    <section class="relative py-16 overflow-hidden">
      <!-- Enhanced decorative blobs -->
      <div class="absolute -top-32 -right-32 w-[32rem] h-[32rem] bg-primary-200/30 rounded-full blur-3xl animate-blob"></div>
      <div class="absolute -bottom-32 -left-32 w-[32rem] h-[32rem] bg-secondary-200/30 rounded-full blur-3xl animate-blob animation-delay-2000"></div>
      <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[32rem] h-[32rem] bg-accent-200/20 rounded-full blur-3xl animate-blob animation-delay-4000"></div>
      
      <div class="container relative z-10">
        <div class="max-w-4xl mx-auto">
          <!-- Story Meta -->
          <div class="flex flex-wrap gap-3 mb-6">
            {story.tags?.map(tag => (
              <TagBadge tag={tag} size="md" />
            ))}
            
            {story.sponsored && (
              <div class="ml-auto">
                <SponsoredBadge type={story.featured ? "featured" : "sponsored"} />
              </div>
            )}
          </div>
          
          <!-- Story Title -->
          <h1 class="text-4xl md:text-5xl font-display font-bold mb-6 text-text-primary fancy-underline transform-style-3d hover:translate-z-8 transition-transform duration-500">
            {story.title}
          </h1>
          
          <!-- Author and Date -->
          <div class="flex items-center justify-between mb-8">
            {story.author && (
              <a href={`/authors/${story.author.slug}`} class="flex items-center group">
                <div class="w-12 h-12 rounded-full overflow-hidden mr-3 border-2 border-white shadow-md">
                  <img 
                    src={story.author.avatar || '/images/default-avatar.svg'} 
                    alt={story.author.name} 
                    class="w-full h-full object-cover"
                  />
                </div>
                <div>
                  <span class="block text-base font-bold text-text-primary group-hover:text-primary transition-colors duration-300">
                    {story.author.name}
                  </span>
                  {formattedDate && (
                    <span class="text-sm text-text-secondary">
                      {formattedDate}
                    </span>
                  )}
                </div>
              </a>
            )}
            
            {story.rating && (
              <div>
                <RatingStars rating={story.rating} size="md" />
              </div>
            )}
          </div>
          
          <!-- Cover Image -->
          <div class="mb-12 rounded-2xl overflow-hidden shadow-xl transform-style-3d hover:translate-z-8 transition-transform duration-500">
            <img 
              src={story.coverImage || '/images/default-cover.svg'} 
              alt={story.title} 
              class="w-full h-auto object-cover"
            />
          </div>
          
          <!-- Story Content -->
          <div class="prose prose-lg max-w-none mb-16">
            {story.content ? (
              <div set:html={story.content} />
            ) : (
              <div class="bg-white p-8 rounded-xl shadow-md">
                <p class="text-lg text-text-secondary">
                  This is a placeholder for the story content. In a real implementation, the full story content would be displayed here.
                </p>
                <p class="text-lg text-text-secondary mt-4">
                  Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vivamus lacinia odio vitae vestibulum vestibulum. Cras porttitor metus in nibh finibus, a volutpat felis condimentum. Nulla facilisi. Phasellus gravida semper nisi. Nulla facilisi. Cras id arcu lorem, et semper purus. Cum sociis natoque penatibus et magnis dis parturient montes, nascetur ridiculus mus. Duis vel est nec sapien suscipit gravida. Aliquam erat volutpat. Ut id magna vitae ante rutrum commodo.
                </p>
                <p class="text-lg text-text-secondary mt-4">
                  Fusce at nisi eget dolor rhoncus facilisis. Mauris ante nisl, consectetur et luctus et, porta ut dolor. Curabitur ultricies ultrices nulla. Morbi blandit nec est vitae dictum. Etiam vel consectetur diam. Maecenas ut tristique mi. Duis vel sapien at odio venenatis facilisis a sit amet lectus.
                </p>
              </div>
            )}
          </div>
          
          <!-- Moderation CTA -->
          <div class="mb-16">
            <ModerationCTA 
              contentType="story" 
              contentId={story.id || slug} 
              reason="Report inappropriate content"
            />
          </div>
          
          <!-- Reviews Section -->
          <ReviewSection
            itemType="story"
            itemId={story.id || slug}
            itemName={story.title}
            rating={story.rating || 0}
            reviewCount={story.reviewCount || 0}
          />
        </div>
      </div>
    </section>
    
    <!-- Related Stories -->
    {relatedStories.length > 0 && (
      <section class="py-16 bg-white">
        <div class="container">
          <h2 class="text-3xl font-display font-bold mb-12 text-text-primary fancy-underline transform-style-3d hover:translate-z-8 transition-transform duration-500">
            Related Stories
          </h2>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 perspective-1000">
            {relatedStories.map((relatedStory, index) => (
              <div 
                class="transform-style-3d hover:translate-z-8 transition-transform duration-700"
                style={`animation: fadeInUp 0.7s ease-out forwards ${index * 0.15}s;`}
              >
                <CardStory story={relatedStory} className="rounded-xl shadow-md hover:shadow-lg transition" />
              </div>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
  
  <Footer />
  
  <style>
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(40px) scale(0.95);
      }
      50% {
        opacity: 0.5;
        transform: translateY(20px) scale(0.97);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }
    
    .fancy-underline {
      position: relative;
      display: inline-block;
    }
    
    .fancy-underline::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: -5px;
      width: 100%;
      height: 3px;
      background: linear-gradient(90deg, var(--color-primary) 0%, var(--color-secondary) 50%, var(--color-accent) 100%);
      border-radius: 3px;
      transform: scaleX(0.7);
      transform-origin: center;
      transition: transform 0.5s ease;
    }
    
    .fancy-underline:hover::after {
      transform: scaleX(1);
    }
  </style>
</body>
</html>