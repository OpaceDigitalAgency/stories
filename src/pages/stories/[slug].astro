---
import Layout from '../../layouts/Layout.astro';
import RatingStars from '../../components/RatingStars.astro';
import TagBadge from '../../components/TagBadge.astro';
import ReviewSection from '../../components/ReviewSection.astro';
import SponsoredBadge from '../../components/SponsoredBadge.astro';
import ModerationCTA from '../../components/ModerationCTA.astro';
import CardStory from '../../components/CardStory.astro';
import ApiErrorMessage from '../../components/ApiErrorMessage.astro';
import { fetchStories, fetchStory } from '../../lib/api';
import type { Story } from '../../lib/api';
import { getConfig } from '../../lib/config';

// Get the slug from the URL
const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/404');
}

// Get site name from config
const siteName = getConfig('site.name', 'Stories From The Web');

// Initialize data
let story: Story | null = null;
let relatedStories: Story[] = [];
let apiError = false;
let apiErrorDetails: Error | null = null;

// Initialize content processing variables
let processedContent = {
  storyContent: null as string | null
};

let formattedDate: string | null = null;

try {
  // Fetch the story and related stories
  const [currentStory, relatedStoriesData] = await Promise.all([
    fetchStory(slug),
    fetchStories(1, 4, { sort: 'publishedAt:desc' }) // Get most recent stories instead of filtering by slug
  ]);

  story = currentStory;
  relatedStories = relatedStoriesData || [];

  if (story) {
    // Process story content
    processedContent.storyContent = story.content?.trim() || null;

    // Format date
    formattedDate = story.publishDate
      ? new Date(story.publishDate).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        })
      : null;
  } else {
    return Astro.redirect('/404');
  }
} catch (err) {
  console.error('Error fetching story:', err);
  apiError = true;
  apiErrorDetails = err instanceof Error ? err : new Error('An unknown error occurred');
  story = null;
  relatedStories = [];
  return Astro.redirect('/404');
}

// Page metadata
const title = story ? `${story.title} | ${siteName}` : siteName;
const description = story?.excerpt || `Read this story on ${siteName}`;
---

<Layout title={title} description={description}>
  <main class="flex-grow w-full">
    {apiError ? (
      <section class="py-8">
        <div class="container mx-auto px-4">
          <ApiErrorMessage error={apiErrorDetails} message="We're having trouble loading this story. Please try again later." />
        </div>
      </section>
    ) : story ? (
    <!-- Story Header -->
    <section class="relative py-16 overflow-hidden">
      <!-- Enhanced decorative blobs -->
      <div class="absolute -top-32 -right-32 w-[32rem] h-[32rem] bg-primary-200/30 rounded-full blur-3xl animate-blob"></div>
      <div class="absolute -bottom-32 -left-32 w-[32rem] h-[32rem] bg-secondary-200/30 rounded-full blur-3xl animate-blob animation-delay-2000"></div>
      <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[32rem] h-[32rem] bg-accent-200/20 rounded-full blur-3xl animate-blob animation-delay-4000"></div>

      <div class="container relative z-10">
        <div class="max-w-4xl mx-auto">
          <!-- Story Meta -->
          <div class="flex flex-wrap gap-3 mb-6">
            {story.tags?.map(tag => (
              <TagBadge tag={tag} size="md" />
            ))}

            {story.sponsored && (
              <div class="ml-auto">
                <SponsoredBadge type={story.featured ? "featured" : "sponsored"} />
              </div>
            )}
          </div>

          <!-- Story Title -->
          <h1 class="text-4xl md:text-5xl font-display font-bold mb-6 text-text-primary fancy-underline transform-style-3d hover:translate-z-8 transition-transform duration-500">
            {story.title}
          </h1>

          <!-- Author and Date -->
          <div class="flex items-center justify-between mb-8">
            {story.author && (
              <a href={`/authors/${story.author.slug}`} class="flex items-center group">
                <div class="w-12 h-12 rounded-full overflow-hidden mr-3 border-2 border-white shadow-md">
                  <img
                    src={story.author.avatar || '/images/default-avatar.svg'}
                    alt={story.author.name}
                    class="w-full h-full object-cover"
                  />
                </div>
                <div>
                  <span class="block text-base font-bold text-text-primary group-hover:text-primary transition-colors duration-300">
                    {story.author.name}
                  </span>
                  {formattedDate && (
                    <span class="text-sm text-text-secondary">
                      {formattedDate}
                    </span>
                  )}
                </div>
              </a>
            )}

            {story.rating && typeof story.rating === 'number' && story.rating > 0 &&
              story.author?.author_type !== 'child' && (
              <div>
                <RatingStars rating={story.rating} size="md" />
              </div>
            )}
          </div>

          <!-- Cover Image -->
          <div class="mb-12 rounded-2xl overflow-hidden shadow-xl transform-style-3d hover:translate-z-8 transition-transform duration-500">
            <img
              src={
                typeof story.coverImage === 'object'
                  ? (story.coverImage.large || story.coverImage.medium || story.coverImage.default)
                  : (story.cover_urls?.large || story.cover_urls?.medium || story.coverImage || '/images/default-cover.svg')
              }
              alt={story.title}
              class="w-full h-auto object-cover"
            />
          </div>

          <!-- Author Info -->
          {story.author?.author_type === 'child' && (
            <div class="bg-purple-50 rounded-xl p-6 mb-8">
              <h2 class="text-xl font-bold text-purple-800 mb-2">About the Author</h2>
              <div class="text-purple-700">
                <p class="mb-2">Age: {story.author.age || 'Not specified'} years old</p>
                <p>From: {story.author.location || 'Not specified'}</p>
              </div>
            </div>
          )}

          <!-- Story Details -->
          <div class="bg-white rounded-xl p-6 mb-8 shadow-md">
            <div class="flex flex-wrap gap-4 text-sm text-gray-600">
              <div>
                <span class="font-semibold">Reading Time:</span> {story.estimated_reading_time || '1'} minute{(story.estimated_reading_time || '1') !== '1' ? 's' : ''}
              </div>
              <div>
                <span class="font-semibold">Age Group:</span> {story.age_group || '7-12'} years
              </div>
              {story.author?.author_type && (
                <div>
                  <span class="font-semibold">Story Type:</span> {story.author.author_type.charAt(0).toUpperCase() + story.author.author_type.slice(1)} Story
                </div>
              )}
              {story.author?.age && (
                <div>
                  <span class="font-semibold">Author Age:</span> {story.author.age} years
                </div>
              )}
              {story.author?.location && (
                <div>
                  <span class="font-semibold">Author Location:</span> {story.author.location}
                </div>
              )}
            </div>
          </div>

          <!-- Story Content -->
          <div class="prose prose-lg max-w-none mb-16">
            {processedContent.storyContent ? (
              <>
                <div class="bg-white p-8 rounded-xl shadow-md mb-8">
                  <h2 class="text-2xl font-bold mb-4">Story Summary</h2>
                  <p class="text-gray-700">{story.excerpt}</p>
                </div>
                <div class="bg-white p-8 rounded-xl shadow-md">
                  <h2 class="text-2xl font-bold mb-4">Story</h2>
                  <div class="text-gray-700 whitespace-pre-line">
                    {processedContent.storyContent}
                  </div>
                </div>
              </>
            ) : (
              <div class="bg-white p-8 rounded-xl shadow-md">
                <p class="text-lg text-text-secondary">
                  {story.excerpt || "This story's content is not available at the moment."}
                </p>
              </div>
            )}
          </div>

          <!-- Moderation CTA - Only show for admins and unpublished/needs moderation stories -->
          {(Astro.locals?.user && 'isAdmin' in Astro.locals.user && (!story.is_published || story.needs_moderation)) && (
            <div class="mb-16">
              <ModerationCTA
                contentType="story"
                contentId={slug}
                reason={story.needs_moderation ? "Story requires moderation" : "Story needs to be published"}
              />
            </div>
          )}

          <!-- Reviews Section - Only show for non-child authors and published stories -->
          {story.author?.author_type !== 'child' && (
            <ReviewSection
              itemType="story"
              itemId={slug}
              itemName={story.title}
              rating={story.rating || 0}
              reviewCount={story.reviewCount || 0}
              authorType={story.author?.author_type || 'retail'}
              isAdmin={'isAdmin' in (Astro.locals?.user || {})}
              isPublished={story.is_published || false}
            />
          )}
        </div>
      </div>
    </section>

    <!-- Related Stories -->
    {relatedStories.length > 0 && (
      <section class="py-16 bg-white">
        <div class="container">
          <h2 class="text-3xl font-display font-bold mb-12 text-text-primary fancy-underline transform-style-3d hover:translate-z-8 transition-transform duration-500">
            Related Stories
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 perspective-1000">
            {relatedStories.map((relatedStory, index) => (
              <div
                class="transform-style-3d hover:translate-z-8 transition-transform duration-700"
                style={`animation: fadeInUp 0.7s ease-out forwards ${index * 0.15}s;`}
              >
                <CardStory story={relatedStory} className="rounded-xl shadow-md hover:shadow-lg transition" />
              </div>
            ))}
          </div>
        </div>
      </section>
    )}
    ) : (
      <section class="py-8">
        <div class="container mx-auto px-4">
          <div class="text-center">
            <h1 class="text-2xl font-bold text-text-primary mb-4">Story Not Found</h1>
            <p class="text-text-secondary">The story you're looking for could not be found.</p>
          </div>
        </div>
      </section>
    )}
  </main>
  <style slot="scripts">
    
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(40px) scale(0.95);
      }
      50% {
        opacity: 0.5;
        transform: translateY(20px) scale(0.97);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .fancy-underline {
      position: relative;
      display: inline-block;
    }

    .fancy-underline::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: -5px;
      width: 100%;
      height: 3px;
      background: linear-gradient(90deg, var(--color-primary) 0%, var(--color-secondary) 50%, var(--color-accent) 100%);
      border-radius: 3px;
      transform: scaleX(0.7);
      transform-origin: center;
      transition: transform 0.5s ease;
    }

    .fancy-underline:hover::after {
      transform: scaleX(1);
    }
  
  </style>
</Layout>