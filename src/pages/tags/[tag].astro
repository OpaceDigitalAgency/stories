---
import Layout from '../../layouts/Layout.astro';
import CardStory from '../../components/CardStory.astro';
import { fetchStories } from '../../lib/api';
import { getConfig } from '../../lib/config';

// Get site name from config
const siteName = getConfig('site.name', 'Stories From The Web');

// Page metadata
const title = siteName;

---

<Layout title={title} description={description}>
  <main class="flex-grow w-full">
    <div class="container mx-auto px-4 py-8">
        <header class="mb-8">
          <h1 class="text-3xl font-bold text-text-primary mb-2">
            {formattedTag} Stories
          </h1>
          <p class="text-text-secondary">
            Discover stories tagged with {formattedTag}
          </p>
        </header>

        {stories.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {stories.map(story => (
              <CardStory story={story} />
            ))}
          </div>
        ) : (
          <div class="text-center py-12">
            <p class="text-text-secondary text-lg">
              No stories found with the tag "{formattedTag}"
            </p>
          </div>
        )}
      </div>
  </main>
</Layout>