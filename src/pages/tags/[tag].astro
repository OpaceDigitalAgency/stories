---
import Layout from '../../layouts/Layout.astro';
import CardStory from '../../components/CardStory.astro';
import { fetchStoriesByTag, type Story } from '../../lib/api';
import { getConfig } from '../../lib/config';
import ApiErrorMessage from '../../components/ApiErrorMessage.astro';

// Get the tag from the URL
const { tag } = Astro.params;

// Format tag for display (replace hyphens with spaces and capitalize)
const formattedTag = tag
  ? tag.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ')
  : '';

// Get site name from config
const siteName = getConfig('site.name', 'Stories From The Web');

// Page metadata
const title = `${formattedTag} Stories | ${siteName}`;
const description = `Discover stories tagged with ${formattedTag} on ${siteName}`;

// Initialize data
let stories: Story[] = [];
let apiError = false;
let apiErrorDetails: Error | null = null;

try {
  // Fetch stories with the given tag
  stories = await fetchStoriesByTag(tag || '');
} catch (err) {
  console.error('Error fetching stories:', err);
  apiError = true;
  apiErrorDetails = err instanceof Error ? err : new Error('An unknown error occurred');
  stories = [];
}

// Redirect to 404 if tag is not provided
if (!tag) {
  return Astro.redirect('/404');
}
---

<Layout title={title} description={description}>
  <main class="flex-grow w-full">
    <div class="container mx-auto px-4 py-8">
      <header class="mb-8">
        <nav class="flex items-center text-sm text-text-secondary mb-4" aria-label="Breadcrumb">
          <ol class="flex items-center space-x-2">
            <li>
              <a href="/" class="hover:text-primary transition-colors duration-300">Home</a>
            </li>
            <li class="flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mx-1">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
              <a href="/tags" class="hover:text-primary transition-colors duration-300">Tags</a>
            </li>
            <li class="flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mx-1">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
              <span class="text-text-secondary/70">{formattedTag}</span>
            </li>
          </ol>
        </nav>

        <h1 class="text-3xl font-bold text-text-primary mb-2">
          {formattedTag} Stories
        </h1>
        <p class="text-text-secondary">
          Discover stories tagged with {formattedTag}
        </p>
      </header>

      {apiError ? (
        <ApiErrorMessage error={apiErrorDetails} message={`We're having trouble loading stories tagged with "${formattedTag}". Please try again later.`} />
      ) : stories.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {stories.map(story => (
            <CardStory story={story} />
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <p class="text-text-secondary text-lg">
            No stories found with the tag "{formattedTag}"
          </p>
        </div>
      )}
    </div>
  </main>
</Layout>