---
import NavHeader from '../../components/NavHeader.astro';
import Footer from '../../components/Footer.astro';
import CardStory from '../../components/CardStory.astro';
import { fetchStoriesByTag } from '../../lib/api';
import '../../styles/base.css';

const { tag } = Astro.params;

if (!tag) {
  return Astro.redirect('/404');
}

// Fetch stories for this tag
let stories = [];
try {
  stories = await fetchStoriesByTag(tag);
} catch (error) {
  console.error(`Error fetching stories for tag ${tag}:`, error);
  return Astro.redirect('/404');
}

// Format tag for display
const formattedTag = tag.split('-').map(word =>
  word.charAt(0).toUpperCase() + word.slice(1)
).join(' ');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{formattedTag} Stories | Stories From The Web</title>
    <meta name="description" content={`Discover stories tagged with ${formattedTag} on Stories From The Web.`} />
  </head>
  <body class="min-h-screen flex flex-col bg-neutral w-full">
    <NavHeader />
    
    <main class="flex-grow w-full">
      <div class="container mx-auto px-4 py-8">
        <header class="mb-8">
          <h1 class="text-3xl font-bold text-text-primary mb-2">
            {formattedTag} Stories
          </h1>
          <p class="text-text-secondary">
            Discover stories tagged with {formattedTag}
          </p>
        </header>

        {stories.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {stories.map(story => (
              <CardStory story={story} />
            ))}
          </div>
        ) : (
          <div class="text-center py-12">
            <p class="text-text-secondary text-lg">
              No stories found with the tag "{formattedTag}"
            </p>
          </div>
        )}
      </div>
    </main>
    
    <Footer />
  </body>
</html>