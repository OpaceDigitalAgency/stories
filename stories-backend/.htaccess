# Enable rewrite engine
RewriteEngine On

# Set base directory
RewriteBase /

# Add CORS headers
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "https://storiesfromtheweb.netlify.app"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization"
    Header set Access-Control-Allow-Credentials "true"
    
    # Handle preflight OPTIONS requests
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]
</IfModule>

# Redirect API requests to the appropriate controllers
RewriteRule ^api/v1/stories/?$ api/v1/index.php?controller=stories [QSA,L]
RewriteRule ^api/v1/stories/([^/]+)/?$ api/v1/index.php?controller=stories&id=$1 [QSA,L]

RewriteRule ^api/v1/authors/?$ api/v1/index.php?controller=authors [QSA,L]
RewriteRule ^api/v1/authors/([^/]+)/?$ api/v1/index.php?controller=authors&id=$1 [QSA,L]

RewriteRule ^api/v1/tags/?$ api/v1/index.php?controller=tags [QSA,L]
RewriteRule ^api/v1/tags/([^/]+)/?$ api/v1/index.php?controller=tags&id=$1 [QSA,L]

RewriteRule ^api/v1/games/?$ api/v1/index.php?controller=games [QSA,L]
RewriteRule ^api/v1/games/([^/]+)/?$ api/v1/index.php?controller=games&id=$1 [QSA,L]

RewriteRule ^api/v1/directory-items/?$ api/v1/index.php?controller=directoryItems [QSA,L]
RewriteRule ^api/v1/directory-items/([^/]+)/?$ api/v1/index.php?controller=directoryItems&id=$1 [QSA,L]

RewriteRule ^api/v1/ai-tools/?$ api/v1/index.php?controller=aiTools [QSA,L]
RewriteRule ^api/v1/ai-tools/([^/]+)/?$ api/v1/index.php?controller=aiTools&id=$1 [QSA,L]

RewriteRule ^api/v1/auth/login/?$ api/v1/index.php?controller=auth&action=login [QSA,L]
RewriteRule ^api/v1/auth/register/?$ api/v1/index.php?controller=auth&action=register [QSA,L]
RewriteRule ^api/v1/auth/refresh/?$ api/v1/index.php?controller=auth&action=refresh [QSA,L]

# Prevent directory listing
Options -Indexes

# Set default character set
AddDefaultCharset UTF-8

# Enable gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Set cache control headers
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType text/html "access plus 1 day"
</IfModule>

# PHP settings
<IfModule mod_php7.c>
    php_flag display_errors Off
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>