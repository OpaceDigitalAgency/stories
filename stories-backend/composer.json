{
    "name": "stories/api",
    "description": "Stories From The Web API",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "firebase/php-jwt": "^6.0",
        "php-webdriver/webdriver": "^1.14",
        "symfony/process": "^5.4",
        "symfony/dom-crawler": "^5.4",
        "symfony/css-selector": "^5.4"
    },
    "autoload": {
        "psr-4": {
            "StoriesAPI\\": "api/v1/",
            "Services\\": "services/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}